<%- include('../partials/head') %><div class="portal-shell"><%- include('../partials/admin-sidebar') %><main class="portal-main" id="main-content"><%- include('../partials/portal-top') %><section class="portal-body"><div class="kpi-grid four"><article><span>Active staff</span><b><%= staff.filter(s=>s.active).length %></b><small>across visible branches</small></article><article><span>Average rating</span><b><%= staff.length?(staff.reduce((a,s)=>a+s.rating,0)/staff.length).toFixed(1):0 %></b><small>guest score</small></article><article><span>Pending leave</span><b><%= leave.filter(l=>l.status==='pending').length %></b><small>awaiting decision</small></article><article><span>Branches</span><b><%= branches.length %></b><small>within access scope</small></article></div><section class="panel table-panel"><div class="panel-head"><div><p class="eyebrow">TEAM DIRECTORY</p><h2>Staff profiles</h2></div></div><div class="table-wrap table-responsive"><table class="table align-middle mb-0"><thead><tr><th>Expert</th><th>Branch</th><th>Speciality</th><th>Hours</th><th>Rating</th><th>Commission</th><th>Status</th></tr></thead><tbody><% staff.forEach(s=>{ %><tr><td><div class="table-person"><img src="<%= s.image %>" alt=""><div><b><%= s.name %></b><small><%= s.title %></small></div></div></td><td><%= s.branch_name %></td><td><%= s.speciality %></td><td><%= s.start_time %>–<%= s.end_time %></td><td>★ <%= s.rating %></td><td><%= s.commission_rate %>%</td><td><span class="status <%= s.active?'confirmed':'cancelled' %>"><%= s.active?'active':'inactive' %></span></td></tr><% }) %></tbody></table></div></section><section class="panel"><div class="panel-head"><div><p class="eyebrow">LEAVE MANAGEMENT</p><h2>Requests and availability</h2></div></div><div class="table-wrap table-responsive"><table class="table align-middle mb-0"><thead><tr><th>Staff</th><th>Dates</th><th>Reason</th><th>Status</th><th>Decision</th></tr></thead><tbody><% leave.forEach(l=>{ %><tr><td><b><%= l.staff_name %></b></td><td><%= dateFmt(l.start_date) %>–<%= dateFmt(l.end_date) %></td><td><%= l.reason||'—' %></td><td><span class="status <%= l.status %>"><%= l.status %></span></td><td><% if(l.status==='pending'){ %><div class="button-row"><form method="post" action="/admin/staff/leave/<%= l.id %>"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><input type="hidden" name="status" value="approved"><button class="btn btn-success-soft btn-sm">Approve</button></form><form method="post" action="/admin/staff/leave/<%= l.id %>"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><input type="hidden" name="status" value="rejected"><button class="btn btn-danger-soft btn-sm">Reject</button></form></div><% } else { %>Completed<% } %></td></tr><% }) %></tbody></table></div></section></section></main></div></body></html>
