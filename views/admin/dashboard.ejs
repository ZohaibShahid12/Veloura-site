<%- include('../partials/head') %><div class="portal-shell"><%- include('../partials/admin-sidebar') %><main class="portal-main" id="main-content"><%- include('../partials/portal-top') %><section class="portal-body"><div class="kpi-grid five"><article><span>Today’s appointments</span><b><%= stats.todayAppointments %></b><small>scheduled visits</small></article><article><span>Pending bookings</span><b><%= stats.pending %></b><small>require attention</small></article><article><span>Recorded revenue</span><b class="kpi-text"><%= money(stats.revenue) %></b><small>payment ledger</small></article><article><span>Customers</span><b><%= stats.customers %></b><small>central CRM</small></article><article class="<%= stats.lowStock?'warning-card':'' %>"><span>Low stock</span><b><%= stats.lowStock %></b><small>products at threshold</small></article></div><div class="portal-grid"><section class="panel span-2"><div class="panel-head"><div><p class="eyebrow">OPERATIONS</p><h2>Recent appointments</h2></div><a href="/admin/appointments">Open calendar</a></div><div class="table-wrap table-responsive"><table class="table align-middle mb-0"><thead><tr><th>Booking</th><th>Guest</th><th>Date & time</th><th>Expert</th><th>Status</th><th>Total</th></tr></thead><tbody><% appointments.forEach(a=>{ %><tr><td><b><%= a.booking_code %></b><small><%= a.branch_name %></small></td><td><%= a.customer_name %></td><td><%= dateFmt(a.appointment_date) %><small><%= a.start_time %></small></td><td><%= a.staff_name||'Unassigned' %></td><td><span class="status <%= a.status %>"><%= a.status %></span></td><td><b><%= money(a.total) %></b></td></tr><% }) %></tbody></table></div></section><aside class="panel"><div class="panel-head"><div><p class="eyebrow">TOP SERVICES</p><h2>Booking mix</h2></div></div><div class="bar-list"><% const max=Math.max(1,...topServices.map(x=>x.bookings)); topServices.forEach(s=>{ %><div><div><b><%= s.name %></b><span><%= s.bookings %> bookings</span></div><i><em style="width:<%= (s.bookings/max)*100 %>%"></em></i><small><%= money(s.revenue) %></small></div><% }) %></div></aside><aside class="panel"><p class="eyebrow">ATTENTION</p><h2>Operational pulse</h2><div class="pulse-list"><a href="/admin/inventory"><span class="pulse-icon warning">!</span><div><b><%= stats.lowStock %> low-stock items</b><small>Review inventory thresholds</small></div></a><a href="/admin/bridal"><span class="pulse-icon">♕</span><div><b><%= stats.bridal %> bridal journeys</b><small>Consultations and events</small></div></a><a href="/admin/customers"><span class="pulse-icon">◎</span><div><b>Customer CRM</b><small>Search or create a record</small></div></a></div></aside><section class="panel span-2"><div class="panel-head"><div><p class="eyebrow">AUDIT TRAIL</p><h2>Recent activity</h2></div><span class="tag">Secure log</span></div><div class="activity-list"><% recent.forEach(r=>{ %><div><span><%= (r.user_name||'System').slice(0,1) %></span><div><b><%= r.user_name||'System' %> · <%= r.action.replaceAll('_',' ') %></b><small><%= r.entity %> <%= r.details||'' %></small></div><time><%= dateTimeFmt(r.created_at) %></time></div><% }) %></div></section></div></section></main></div></body></html>
