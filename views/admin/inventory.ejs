<%- include('../partials/head') %><div class="portal-shell"><%- include('../partials/admin-sidebar') %><main class="portal-main" id="main-content"><%- include('../partials/portal-top') %><section class="portal-body"><div class="toolbar"><div><p class="muted">Track branch stock, service consumption, purchases, damage and low-stock thresholds.</p></div><button class="btn btn-primary" data-modal-open="stockModal">+ Record stock movement</button></div><div class="inventory-grid"><% products.forEach(p=>{ %><article class="inventory-card <%= p.stock<=p.min_stock?'low':'' %>"><div><img src="<%= p.image %>" alt=""><span class="status <%= p.stock<=p.min_stock?'warning':'confirmed' %>"><%= p.stock<=p.min_stock?'low stock':'healthy' %></span></div><h3><%= p.name %></h3><p><%= p.branch_name||'Central stock' %> · <%= p.category %></p><div class="stock-meter"><i><em style="width:<%= Math.min(100,(p.stock/Math.max(p.min_stock*3,1))*100) %>%"></em></i><div><b><%= p.stock %> units</b><small>Minimum <%= p.min_stock %></small></div></div></article><% }) %></div><section class="panel table-panel"><div class="panel-head"><div><p class="eyebrow">STOCK LEDGER</p><h2>Recent inventory movements</h2></div></div><div class="table-wrap table-responsive"><table class="table align-middle mb-0"><thead><tr><th>Product</th><th>Branch</th><th>Movement</th><th>Quantity</th><th>Reason</th><th>Date</th></tr></thead><tbody><% movements.forEach(m=>{ %><tr><td><b><%= m.product_name %></b></td><td><%= m.branch_name||'—' %></td><td><span class="status <%= m.quantity>0?'confirmed':'warning' %>"><%= m.movement_type %></span></td><td><b><%= m.quantity>0?'+':'' %><%= m.quantity %></b></td><td><%= m.reason||'—' %></td><td><%= dateTimeFmt(m.created_at) %></td></tr><% }) %></tbody></table></div></section></section></main></div><div class="modal" id="stockModal" data-modal><div class="modal-card"><button class="modal-close" data-modal-close>×</button><p class="eyebrow">INVENTORY MOVEMENT</p><h2>Adjust stock</h2><form action="/admin/inventory/adjust" method="post" class="premium-form"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><label>Product<select name="product_id"><% products.forEach(p=>{ %><option value="<%= p.id %>"><%= p.name %> · <%= p.stock %> units</option><% }) %></select></label><label>Movement type<select name="movement_type"><option>purchase</option><option>service usage</option><option>adjustment</option><option>damage</option><option>return</option><option>transfer</option></select></label><label>Quantity<input required type="number" name="quantity" placeholder="Use a negative number for stock out"></label><label>Reason<textarea name="reason" rows="3"></textarea></label><button class="btn btn-primary btn-block">Record movement</button></form></div></div></body></html>
