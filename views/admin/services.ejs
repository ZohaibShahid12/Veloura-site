<%- include('../partials/head') %><div class="portal-shell"><%- include('../partials/admin-sidebar') %><main class="portal-main" id="main-content"><%- include('../partials/portal-top') %><section class="portal-body"><div class="toolbar"><div><p class="muted">Manage public service pricing, duration, category and home-service availability.</p></div><button class="btn btn-primary" data-modal-open="serviceModal">+ Add service</button></div><section class="panel table-panel"><div class="table-wrap table-responsive"><table class="table align-middle mb-0"><thead><tr><th>Service</th><th>Category</th><th>Price</th><th>Duration</th><th>Rating</th><th>Home</th><th>Status</th></tr></thead><tbody><% services.forEach(s=>{ %><tr><td><div class="table-person"><span>✦</span><div><b><%= s.name %></b><small><%= s.slug %></small></div></div></td><td><%= s.category_name %></td><td><b><%= money(s.price) %></b></td><td><%= s.duration %> min</td><td>★ <%= s.rating %></td><td><%= s.home_service?'Yes':'No' %></td><td><span class="status <%= s.active?'confirmed':'cancelled' %>"><%= s.active?'active':'inactive' %></span></td></tr><% }) %></tbody></table></div></section></section></main></div><div class="modal" id="serviceModal" data-modal><div class="modal-card wide"><button class="modal-close" data-modal-close>×</button><p class="eyebrow">SERVICE CATALOGUE</p><h2>Add a service</h2><form method="post" action="/admin/services/save" class="premium-form"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><label>Service name<input required name="name"></label><label>Category<select name="category_id"><% serviceCategories.forEach(c=>{ %><option value="<%= c.id %>"><%= c.name %></option><% }) %></select></label><div class="form-row"><label>Price<input required type="number" name="price" min="0"></label><label>Duration minutes<input required type="number" name="duration" min="15"></label></div><label>Description<textarea required name="description" rows="4"></textarea></label><label class="check-line"><input type="checkbox" name="home_service">Available as home service</label><button class="btn btn-primary btn-block">Save service</button></form></div></div></body></html>
