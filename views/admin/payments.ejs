<%- include('../partials/head') %><div class="portal-shell"><%- include('../partials/admin-sidebar') %><main class="portal-main" id="main-content"><%- include('../partials/portal-top') %><section class="portal-body"><div class="kpi-grid three"><article><span>Payment entries</span><b><%= payments.length %></b><small>in current scope</small></article><article><span>Paid amount</span><b class="kpi-text"><%= money(payments.filter(p=>p.status==='paid').reduce((a,p)=>a+p.amount,0)) %></b><small>recorded payments</small></article><article><span>Methods</span><b><%= new Set(payments.map(p=>p.method)).size %></b><small>active channels</small></article></div><section class="panel table-panel"><div class="panel-head"><div><p class="eyebrow">PAYMENT LEDGER</p><h2>Transactions and references</h2></div><button class="btn btn-soft btn-sm" onclick="window.print()">Print report</button></div><div class="table-wrap table-responsive"><table class="table align-middle mb-0"><thead><tr><th>Payment</th><th>Customer</th><th>Related record</th><th>Method</th><th>Status</th><th>Amount</th><th>Date</th></tr></thead><tbody><% payments.forEach(p=>{ %><tr><td><b><%= p.payment_code %></b><small><%= p.reference||'—' %></small></td><td><%= p.customer_name||'Guest' %></td><td><%= p.booking_code||p.order_code||'Standalone' %></td><td><%= p.method %></td><td><span class="status <%= p.status %>"><%= p.status %></span></td><td><b><%= money(p.amount) %></b></td><td><%= dateTimeFmt(p.created_at) %></td></tr><% }) %></tbody></table></div></section></section></main></div></body></html>
