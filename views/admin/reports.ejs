<%- include('../partials/head') %><div class="portal-shell"><%- include('../partials/admin-sidebar') %><main class="portal-main" id="main-content"><%- include('../partials/portal-top') %><section class="portal-body"><div class="toolbar"><form method="get" class="inline-filters compact"><label>From<input type="date" name="from" value="<%= from %>"></label><label>To<input type="date" name="to" value="<%= to %>"></label><button class="btn btn-primary">Run report</button></form><button class="btn btn-soft" onclick="window.print()">Print / Save PDF</button></div><div class="kpi-grid four"><article><span>Revenue</span><b class="kpi-text"><%= money(totalRevenue) %></b><small>selected period</small></article><article><span>Expenses</span><b class="kpi-text"><%= money(expenses) %></b><small>recorded costs</small></article><article><span>Estimated profit</span><b class="kpi-text"><%= money(profit) %></b><small>revenue minus expenses</small></article><article><span>Service categories</span><b><%= serviceRevenue.length %></b><small>with booking activity</small></article></div><div class="portal-grid"><section class="panel span-2"><div class="panel-head"><div><p class="eyebrow">REVENUE TREND</p><h2>Daily recorded payments</h2></div><span class="tag"><%= dateFmt(from) %>–<%= dateFmt(to) %></span></div><div class="chart" data-chart><% const maxRevenue=Math.max(1,...revenue.map(r=>r.total)); revenue.forEach(r=>{ %><div class="chart-bar"><i style="height:<%= Math.max(5,(r.total/maxRevenue)*100) %>%"><span><%= money(r.total) %></span></i><small><%= String(r.day).slice(5) %></small></div><% }) %><% if(!revenue.length){ %><div class="empty-inline">No payment data in this period.</div><% } %></div></section><aside class="panel"><p class="eyebrow">BRANCH PERFORMANCE</p><h2>Revenue by location</h2><div class="bar-list"><% const maxBranch=Math.max(1,...branchRevenue.map(r=>r.revenue)); branchRevenue.forEach(b=>{ %><div><div><b><%= b.name %></b><span><%= money(b.revenue) %></span></div><i><em style="width:<%= (b.revenue/maxBranch)*100 %>%"></em></i></div><% }) %></div></aside><section class="panel span-3"><div class="panel-head"><div><p class="eyebrow">SERVICE PERFORMANCE</p><h2>Revenue and booking mix</h2></div></div><div class="table-wrap table-responsive"><table class="table align-middle mb-0"><thead><tr><th>Service</th><th>Bookings</th><th>Recorded revenue</th><th>Average value</th></tr></thead><tbody><% serviceRevenue.forEach(s=>{ %><tr><td><b><%= s.name %></b></td><td><%= s.bookings %></td><td><%= money(s.revenue) %></td><td><%= money(s.revenue/Math.max(s.bookings,1)) %></td></tr><% }) %></tbody></table></div></section></div></section></main></div></body></html>
