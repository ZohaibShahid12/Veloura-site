<%- include('../partials/head') %><div class="portal-shell"><%- include('../partials/admin-sidebar') %><main class="portal-main" id="main-content"><%- include('../partials/portal-top') %><section class="portal-body"><div class="toolbar"><p class="muted">Branch hours control live booking slots. Prices, staff and stock remain branch-aware.</p><button class="btn btn-primary" data-modal-open="branchModal">+ Add branch</button></div><div class="branch-admin-grid"><% branches.forEach((b,i)=>{ %><article class="branch-admin-card"><span>0<%= i+1 %></span><div class="branch-admin-head"><div><p class="eyebrow"><%= b.city %></p><h2><%= b.name %></h2></div><span class="status <%= b.active?'confirmed':'cancelled' %>"><%= b.active?'active':'inactive' %></span></div><p><%= b.address %></p><dl class="profile-list"><div><dt>Phone</dt><dd><%= b.phone %></dd></div><div><dt>Hours</dt><dd><%= b.opening_time %>–<%= b.closing_time %></dd></div></dl><a class="btn btn-soft btn-block" href="/admin/appointments">View branch schedule</a></article><% }) %></div></section></main></div><div class="modal" id="branchModal" data-modal><div class="modal-card"><button class="modal-close" data-modal-close>×</button><p class="eyebrow">NEW LOCATION</p><h2>Add branch</h2><form action="/admin/branches/save" method="post" class="premium-form"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><label>Branch name<input required name="name"></label><div class="form-row"><label>City<input required name="city"></label><label>Phone<input name="phone"></label></div><label>Address<textarea required name="address" rows="3"></textarea></label><div class="form-row"><label>Opening<input type="time" name="opening_time" value="09:00"></label><label>Closing<input type="time" name="closing_time" value="21:00"></label></div><button class="btn btn-primary btn-block">Save branch</button></form></div></div></body></html>
