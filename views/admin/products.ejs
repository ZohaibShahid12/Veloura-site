<%- include('../partials/head') %><div class="portal-shell"><%- include('../partials/admin-sidebar') %><main class="portal-main" id="main-content"><%- include('../partials/portal-top') %><section class="portal-body"><div class="toolbar"><p class="muted">Products published here are connected to the public shop, cart, checkout and inventory.</p><button class="btn btn-primary" data-modal-open="productModal">+ Add product</button></div><section class="panel table-panel"><div class="table-wrap table-responsive"><table class="table align-middle mb-0"><thead><tr><th>Product</th><th>Branch</th><th>Category</th><th>Price</th><th>Stock</th><th>Threshold</th><th>Status</th></tr></thead><tbody><% products.forEach(p=>{ %><tr><td><div class="table-person"><img src="<%= p.image %>" alt=""><div><b><%= p.name %></b><small><%= p.brand %></small></div></div></td><td><%= p.branch_name||'Central' %></td><td><%= p.category %></td><td><b><%= money(p.price) %></b></td><td><%= p.stock %></td><td><%= p.min_stock %></td><td><span class="status <%= p.active?'confirmed':'cancelled' %>"><%= p.active?'active':'inactive' %></span></td></tr><% }) %></tbody></table></div></section></section></main></div><div class="modal" id="productModal" data-modal><div class="modal-card wide"><button class="modal-close" data-modal-close>×</button><p class="eyebrow">PRODUCT CATALOGUE</p><h2>Add shop product</h2><form action="/admin/products/save" method="post" class="premium-form"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><div class="form-row"><label>Name<input required name="name"></label><label>Brand<input required name="brand"></label></div><div class="form-row"><label>Category<input required name="category"></label><label>Branch<select name="branch_id"><% branches.forEach(b=>{ %><option value="<%= b.id %>"><%= b.name %></option><% }) %></select></label></div><div class="form-row"><label>Price<input required type="number" name="price"></label><label>Starting stock<input required type="number" name="stock"></label></div><label>Minimum stock<input required type="number" name="min_stock" value="5"></label><label>Description<textarea required name="description" rows="4"></textarea></label><button class="btn btn-primary btn-block">Save product</button></form></div></div></body></html>
