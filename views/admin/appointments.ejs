<%- include('../partials/head') %><div class="portal-shell"><%- include('../partials/admin-sidebar') %><main class="portal-main" id="main-content"><%- include('../partials/portal-top') %><section class="portal-body"><div class="toolbar"><form method="get" class="inline-filters compact"><label>Date<input type="date" name="date" value="<%= filters.date %>"></label><label>Status<select name="status"><option value="">All statuses</option><% ['confirmed','checked-in','in-service','completed','cancelled','no-show'].forEach(s=>{ %><option <%= filters.status===s?'selected':'' %>><%= s %></option><% }) %></select></label><button class="btn btn-primary">Apply</button><a class="btn btn-soft" href="/admin/appointments">Reset</a></form><a class="btn btn-primary" href="/book">+ Create appointment</a></div><section class="panel table-panel"><div class="panel-head"><div><p class="eyebrow">LIVE SCHEDULE</p><h2><%= appointments.length %> appointments</h2></div><span class="tag">Drag-ready architecture</span></div><div class="table-wrap table-responsive"><table class="table align-middle mb-0"><thead><tr><th>Booking</th><th>Guest</th><th>Services</th><th>Date & time</th><th>Branch / expert</th><th>Payment</th><th>Status action</th></tr></thead><tbody><% appointments.forEach(a=>{ %><tr><td><b><%= a.booking_code %></b><small><%= a.visit_type %></small></td><td><a href="/admin/customers"><b><%= a.customer_name %></b></a><small><%= a.customer_phone %></small></td><td><%= a.services %></td><td><%= dateFmt(a.appointment_date) %><small><%= a.start_time %>–<%= a.end_time %></small></td><td><%= a.branch_name %><small><%= a.staff_name||'Unassigned' %></small></td><td><%= money(a.total) %><small><%= a.payment_status %></small></td><td><form method="post" action="/admin/appointments/<%= a.id %>/status" class="status-form"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><select name="status"><% ['confirmed','checked-in','in-service','paused','completed','cancelled','no-show'].forEach(s=>{ %><option value="<%= s %>" <%= a.status===s?'selected':'' %>><%= s %></option><% }) %></select><button class="btn btn-soft btn-sm">Save</button></form></td></tr><% }) %></tbody></table></div></section><div class="calendar-note"><span>◫</span><div><b>Conflict-safe scheduling is active</b><p>New and rescheduled bookings revalidate staff hours, leave, service qualification and overlapping appointments before saving.</p></div></div></section></main></div></body></html>
