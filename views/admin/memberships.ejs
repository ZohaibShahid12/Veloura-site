<%- include('../partials/head') %><div class="portal-shell"><%- include('../partials/admin-sidebar') %><main class="portal-main" id="main-content"><%- include('../partials/portal-top') %><section class="portal-body"><div class="toolbar"><p class="muted">Plans are connected to customer accounts, booking discounts and loyalty multipliers.</p><button class="btn btn-primary" data-modal-open="membershipModal">+ Add membership</button></div><div class="membership-grid compact-grid"><% memberships.forEach(m=>{ %><article class="membership-card"><p class="eyebrow"><%= m.name %></p><h2><%= money(m.price_monthly) %><small>/month</small></h2><p><%= money(m.price_yearly) %> annually</p><div class="membership-value"><b><%= m.discount_percent %>%</b><span>savings</span><b><%= m.points_multiplier %>×</b><span>points</span></div><ul><% String(m.benefits).split('|').forEach(b=>{ %><li>✓ <%= b %></li><% }) %></ul><span class="status <%= m.active?'confirmed':'cancelled' %>"><%= m.active?'active':'inactive' %></span></article><% }) %></div></section></main></div><div class="modal" id="membershipModal" data-modal><div class="modal-card"><button class="modal-close" data-modal-close>×</button><p class="eyebrow">MEMBERSHIP PLAN</p><h2>Create plan</h2><form action="/admin/memberships/save" method="post" class="premium-form"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><label>Name<input required name="name"></label><div class="form-row"><label>Monthly price<input type="number" required name="price_monthly"></label><label>Annual price<input type="number" required name="price_yearly"></label></div><div class="form-row"><label>Discount %<input type="number" required name="discount_percent"></label><label>Points multiplier<input type="number" step="0.1" required name="points_multiplier"></label></div><label>Benefits<textarea required name="benefits" rows="4" placeholder="Separate benefits with |"></textarea></label><button class="btn btn-primary btn-block">Save plan</button></form></div></div></body></html>
