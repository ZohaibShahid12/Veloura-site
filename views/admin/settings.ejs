<%- include('../partials/head') %><div class="portal-shell"><%- include('../partials/admin-sidebar') %><main class="portal-main" id="main-content"><%- include('../partials/portal-top') %><section class="portal-body"><div class="settings-layout"><form method="post" action="/admin/settings" class="panel premium-form"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><p class="eyebrow">GENERAL CONFIGURATION</p><h2>Salon settings</h2><label>Salon name<input name="salon_name" value="<%= settings.salon_name||'Veloura Salon' %>"></label><label>Currency<input name="currency" value="<%= settings.currency||'PKR' %>"></label><label>Booking deposit percentage<input type="number" min="0" max="100" name="booking_deposit_percent" value="<%= settings.booking_deposit_percent||30 %>"></label><button class="btn btn-primary">Save settings</button></form><aside class="panel"><p class="eyebrow">SYSTEM CONTROLS</p><h2>Security status</h2><ul class="security-list"><li><span>✓</span><div><b>Password hashing</b><small>Node scrypt with unique salts</small></div></li><li><span>✓</span><div><b>CSRF protection</b><small>Session-bound form tokens</small></div></li><li><span>✓</span><div><b>Role-based access</b><small>Customer, staff, receptionist, manager and admin</small></div></li><li><span>✓</span><div><b>Audit trail</b><small>Important actions recorded</small></div></li><li><span>✓</span><div><b>Conflict-safe booking</b><small>Transaction revalidation before save</small></div></li></ul></aside><aside class="panel"><p class="eyebrow">INTEGRATIONS</p><h2>Sandbox-ready adapters</h2><p>Card, Easypaisa, JazzCash, email, SMS and WhatsApp appear as configurable channels. Live credentials must be added before production deployment.</p><div class="notice-box">No complete card data is stored in this application.</div></aside></div></section></main></div></body></html>
