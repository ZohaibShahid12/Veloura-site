<%- include('../partials/head') %><div class="portal-shell"><%- include('../partials/admin-sidebar') %><main class="portal-main" id="main-content"><%- include('../partials/portal-top') %><section class="portal-body"><div class="customer-banner"><div class="customer-avatar"><%= customer.name.slice(0,1) %></div><div><div class="tag-row"><span class="status <%= customer.category.toLowerCase() %>"><%= customer.category %></span><span class="tag"><%= customer.customer_code %></span></div><h2><%= customer.name %></h2><p><%= customer.phone||'No phone' %> · <%= customer.email||'No email' %></p></div><div class="customer-totals"><div><small>Total spent</small><b><%= money(customer.total_spent) %></b></div><div><small>Pending balance</small><b><%= money(customer.pending_balance) %></b></div><div><small>Loyalty</small><b><%= customer.loyalty_points %> pts</b></div></div></div><div class="portal-grid"><section class="panel"><p class="eyebrow">PERSONAL & CARE</p><h2>Profile details</h2><dl class="profile-list"><div><dt>WhatsApp</dt><dd><%= customer.whatsapp||'—' %></dd></div><div><dt>Date of birth</dt><dd><%= dateFmt(customer.dob) %></dd></div><div><dt>Skin type</dt><dd><%= customer.skin_type||'—' %></dd></div><div><dt>Hair type</dt><dd><%= customer.hair_type||'—' %></dd></div><div><dt>Allergies</dt><dd><%= customer.allergies||'None saved' %></dd></div><div><dt>Sensitivities</dt><dd><%= customer.sensitivities||'None saved' %></dd></div><div><dt>Membership</dt><dd><%= customer.membership_name||'None' %></dd></div><div><dt>Preferred expert</dt><dd><%= customer.preferred_staff_name||'Any' %></dd></div><div><dt>Favourite branch</dt><dd><%= customer.favourite_branch_name||'Not set' %></dd></div></dl></section><section class="panel span-2"><div class="panel-head"><div><p class="eyebrow">APPOINTMENT HISTORY</p><h2><%= appointments.length %> recorded visits</h2></div><a href="/admin/appointments">Manage calendar</a></div><div class="table-wrap table-responsive"><table class="table align-middle mb-0"><thead><tr><th>Booking</th><th>Services</th><th>Date</th><th>Expert</th><th>Status</th><th>Total</th></tr></thead><tbody><% appointments.forEach(a=>{ %><tr><td><b><%= a.booking_code %></b></td><td><%= a.services %></td><td><%= dateFmt(a.appointment_date) %><small><%= a.start_time %></small></td><td><%= a.staff_name||'—' %></td><td><span class="status <%= a.status %>"><%= a.status %></span></td><td><%= money(a.total) %></td></tr><% }) %></tbody></table></div></section><section class="panel"><p class="eyebrow">INTERNAL NOTES</p><h2>Staff-only context</h2><p><%= customer.internal_notes||'No internal notes have been recorded.' %></p><div class="notice-box">This information is never shown in the customer portal.</div></section><section class="panel"><p class="eyebrow">PRODUCT ORDERS</p><h2><%= orders.length %> orders</h2><% orders.slice(0,6).forEach(o=>{ %><div class="order-mini"><div><b><%= o.order_code %></b><small><%= dateTimeFmt(o.created_at) %></small></div><div><b><%= money(o.total) %></b><span class="status <%= o.status %>"><%= o.status %></span></div></div><% }) %></section><section class="panel span-2"><p class="eyebrow">CONSULTATIONS</p><h2>Recorded beauty goals</h2><% consultations.forEach(c=>{ %><article class="consultation-card"><div><b><%= dateTimeFmt(c.created_at) %></b><span class="status <%= c.consent?'confirmed':'warning' %>"><%= c.consent?'consent recorded':'consent missing' %></span></div><p><strong>Skin:</strong> <%= c.skin_concerns||'—' %></p><p><strong>Hair:</strong> <%= c.hair_concerns||'—' %></p><p><strong>Goals:</strong> <%= c.goals||'—' %></p></article><% }) %><% if(!consultations.length){ %><p class="muted">No consultation records.</p><% } %></section></div></section></main></div></body></html>
