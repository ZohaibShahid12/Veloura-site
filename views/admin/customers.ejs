<%- include('../partials/head') %><div class="portal-shell"><%- include('../partials/admin-sidebar') %><main class="portal-main" id="main-content"><%- include('../partials/portal-top') %><section class="portal-body"><div class="toolbar"><form method="get" class="search-box"><input name="search" value="<%= search %>" placeholder="Search name, phone, email or Customer ID"><button>Search</button></form><button class="btn btn-primary" data-modal-open="newCustomer">+ Add walk-in customer</button></div><section class="panel table-panel"><div class="panel-head"><div><p class="eyebrow">CENTRAL CRM</p><h2><%= customers.length %> customer records</h2></div><span class="tag">Duplicate protected</span></div><div class="table-wrap table-responsive"><table class="table align-middle mb-0"><thead><tr><th>Customer</th><th>Contact</th><th>Category</th><th>Membership</th><th>Total spent</th><th>Balance</th><th>Last visit</th><th></th></tr></thead><tbody><% customers.forEach(c=>{ %><tr><td><div class="table-person"><span><%= c.name.slice(0,1) %></span><div><b><%= c.name %></b><small><%= c.customer_code %></small></div></div></td><td><%= c.phone||'—' %><small><%= c.email||'—' %></small></td><td><span class="status <%= c.category.toLowerCase() %>"><%= c.category %></span></td><td><%= c.membership_name||'None' %></td><td><b><%= money(c.total_spent) %></b></td><td><%= money(c.pending_balance) %></td><td><%= dateFmt(c.last_visit) %></td><td><a class="text-button" href="/admin/customers/<%= c.id %>">Open →</a></td></tr><% }) %></tbody></table></div></section><section class="panel merge-panel"><div><p class="eyebrow">DUPLICATE CONTROL</p><h2>Merge customer records</h2><p>Move appointments, orders, payments and history into the retained record.</p></div><form method="post" action="/admin/customers/merge" class="inline-form" onsubmit="return confirm('Merge these records? This cannot be undone.')"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><label>Keep ID<input required type="number" name="keep_id"></label><label>Remove ID<input required type="number" name="remove_id"></label><button class="btn btn-danger-soft">Merge records</button></form></section></section></main></div><div class="modal" id="newCustomer" data-modal><div class="modal-card"><button class="modal-close" data-modal-close>×</button><p class="eyebrow">WALK-IN CUSTOMER</p><h2>Create or locate profile</h2><p>Matching phone or email records are reused automatically.</p><form method="post" action="/admin/customers" class="premium-form"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><label>Full name<input required name="name"></label><div class="form-row"><label>Phone<input required name="phone"></label><label>WhatsApp<input name="whatsapp"></label></div><label>Email<input type="email" name="email"></label><button class="btn btn-primary btn-block">Save customer</button></form></div></div></body></html>
