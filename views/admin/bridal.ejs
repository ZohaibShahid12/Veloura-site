<%- include('../partials/head') %><div class="portal-shell"><%- include('../partials/admin-sidebar') %><main class="portal-main" id="main-content"><%- include('../partials/portal-top') %><section class="portal-body"><div class="bridal-admin-grid"><% bridal.forEach(b=>{ %><article class="bridal-admin-card"><div class="bridal-admin-head"><span>♕</span><div><p class="eyebrow"><%= b.event_type %></p><h2><%= b.customer_name %></h2><small><%= b.phone %> · <%= dateFmt(b.event_date) %></small></div><span class="status <%= b.status %>"><%= b.status %></span></div><div class="bridal-finance"><div><small>Total</small><b><%= money(b.total) %></b></div><div><small>Deposit</small><b><%= money(b.deposit) %></b></div><div><small>Balance</small><b><%= money(b.balance) %></b></div></div><form method="post" action="/admin/bridal/<%= b.id %>" class="premium-form"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><div class="form-row"><label>Coordinator<input name="coordinator" value="<%= b.coordinator||'' %>"></label><label>Status<select name="status"><% ['consultation','quoted','trial-booked','confirmed','in-progress','completed','cancelled'].forEach(s=>{ %><option <%= b.status===s?'selected':'' %>><%= s %></option><% }) %></select></label></div><div class="form-row three"><label>Total<input type="number" name="total" value="<%= b.total %>"></label><label>Deposit<input type="number" name="deposit" value="<%= b.deposit %>"></label><label>Balance<input type="number" name="balance" value="<%= b.balance %>"></label></div><label>Timeline / notes<textarea name="notes" rows="3"><%= b.notes||'' %></textarea></label><button class="btn btn-primary btn-block">Update bridal journey</button></form></article><% }) %></div><% if(!bridal.length){ %><div class="empty-state"><span>♕</span><h3>No bridal consultations</h3></div><% } %></section></main></div></body></html>
