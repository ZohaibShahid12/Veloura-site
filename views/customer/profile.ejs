<%- include('../partials/head') %><%- include('../partials/header') %><%- include('../partials/flash') %><main id="main-content" class="account-page"><div class="container account-layout"><%- include('../partials/customer-sidebar') %><section class="account-content"><div class="account-head"><div><p class="eyebrow">PERSONAL DETAILS</p><h1>Profile & preferences</h1><p>Keep your contact, care history and preferred experience up to date.</p></div></div><div class="account-grid"><section class="panel span-2"><div class="panel-head"><div><p class="eyebrow">YOUR PROFILE</p><h2>Contact and beauty information</h2></div><span class="status confirmed"><%= customer.category %></span></div><form method="post" action="/account/profile" class="premium-form"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><div class="form-row"><label>Full name<input required name="name" value="<%= customer.name %>"></label><label>Date of birth<input type="date" name="dob" value="<%= customer.dob||'' %>"></label></div><div class="form-row"><label>Email<input required type="email" name="email" value="<%= customer.email||'' %>"></label><label>Phone<input required name="phone" value="<%= customer.phone||'' %>"></label></div><div class="form-row"><label>WhatsApp<input name="whatsapp" value="<%= customer.whatsapp||'' %>"></label><label>Gender<select name="gender"><option value="">Prefer not to say</option><option <%= customer.gender==='Female'?'selected':'' %>>Female</option><option <%= customer.gender==='Other'?'selected':'' %>>Other</option></select></label></div><div class="form-row"><label>Skin type<select name="skin_type"><option value="">Select</option><% ['Dry','Oily','Combination','Normal','Sensitive'].forEach(x=>{ %><option <%= customer.skin_type===x?'selected':'' %>><%= x %></option><% }) %></select></label><label>Hair type<select name="hair_type"><option value="">Select</option><% ['Straight','Wavy','Curly','Coily','Fine','Thick'].forEach(x=>{ %><option <%= customer.hair_type===x?'selected':'' %>><%= x %></option><% }) %></select></label></div><div class="form-row"><label>Preferred expert<select name="preferred_staff_id"><option value="">Any expert</option><% experts.forEach(e=>{ %><option value="<%= e.id %>" <%= customer.preferred_staff_id===e.id?'selected':'' %>><%= e.name %></option><% }) %></select></label><label>Favourite branch<select name="favourite_branch_id"><option value="">Select branch</option><% branches.forEach(b=>{ %><option value="<%= b.id %>" <%= customer.favourite_branch_id===b.id?'selected':'' %>><%= b.name %></option><% }) %></select></label></div><div class="form-row"><label>Allergies<textarea name="allergies" rows="3"><%= customer.allergies||'' %></textarea></label><label>Sensitivities<textarea name="sensitivities" rows="3"><%= customer.sensitivities||'' %></textarea></label></div><hr><p class="eyebrow">ADD AN ADDRESS</p><div class="form-row"><label>Label<input name="address_label" placeholder="Home, Office..."></label><label>City<input name="city"></label></div><label>Complete address<textarea name="address" rows="2"></textarea></label><label class="check-line"><input type="checkbox" name="is_default">Make this my default address</label><button class="btn btn-primary">Save profile</button></form></section><aside class="panel"><p class="eyebrow">CUSTOMER ID</p><h2><%= customer.customer_code %></h2><dl class="profile-list"><div><dt>Registered</dt><dd><%= dateTimeFmt(customer.created_at) %></dd></div><div><dt>Total spent</dt><dd><%= money(customer.total_spent) %></dd></div><div><dt>Pending balance</dt><dd><%= money(customer.pending_balance) %></dd></div><div><dt>Loyalty points</dt><dd><%= customer.loyalty_points %></dd></div></dl></aside><aside class="panel"><p class="eyebrow">SAVED ADDRESSES</p><% addresses.forEach(a=>{ %><div class="address-card"><b><%= a.label %> <%= a.is_default?'· Default':'' %></b><p><%= a.address %>, <%= a.city %></p></div><% }) %><% if(!addresses.length){ %><p class="muted">No saved addresses yet.</p><% } %></aside></div></section></div></main><%- include('../partials/footer') %>
