<%- include('../partials/head') %><%- include('../partials/header') %><%- include('../partials/flash') %><main id="main-content" class="account-page"><div class="container account-layout"><%- include('../partials/customer-sidebar') %><section class="account-content"><div class="account-head"><div><p class="eyebrow">COMMUNICATIONS</p><h1>Notifications</h1><p>Booking, payment, loyalty and order updates appear here.</p></div></div><div class="notification-list"><% notifications.forEach(n=>{ %><article><span class="notification-icon"><%= n.channel==='in-app'?'◌':'✦' %></span><div><div class="notification-head"><h3><%= n.title %></h3><small><%= dateTimeFmt(n.created_at) %></small></div><p><%= n.message %></p><span class="tag"><%= n.channel %></span></div></article><% }) %><% if(!notifications.length){ %><div class="empty-state"><span>◌</span><h3>No notifications yet</h3><p>Important updates will appear here.</p></div><% } %></div></section></div></main><%- include('../partials/footer') %>
