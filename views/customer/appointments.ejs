<%- include('../partials/head') %><%- include('../partials/header') %><%- include('../partials/flash') %><main id="main-content" class="account-page"><div class="container account-layout"><%- include('../partials/customer-sidebar') %><section class="account-content"><div class="account-head"><div><p class="eyebrow">MY SCHEDULE</p><h1>Appointments</h1><p>Review, reschedule, cancel or repeat your salon visits.</p></div><a class="btn btn-primary" href="/book">New appointment</a></div><div class="appointment-list-full"><% appointments.forEach(a=>{ %><article class="appointment-card-full"><div class="appointment-card-top"><div><span class="status <%= a.status %>"><%= a.status %></span><small><%= a.booking_code %></small></div><b><%= money(a.total) %></b></div><div class="appointment-main"><div class="date-large"><b><%= String(a.appointment_date).slice(8,10) %></b><span><%= dateFmt(a.appointment_date).split(' ').slice(1).join(' ') %></span></div><div><h2><%= a.services %></h2><p><%= a.branch_name %> · <%= a.staff_name||'Expert to be assigned' %></p><div class="tag-row"><span><%= a.start_time %>–<%= a.end_time %></span><span><%= a.visit_type %> visit</span><span><%= a.payment_status %></span></div></div></div><% if(!['completed','cancelled'].includes(a.status)){ %><div class="appointment-actions"><details><summary class="btn btn-soft btn-sm">Reschedule</summary><form method="post" action="/account/appointments/<%= a.id %>/reschedule" class="inline-action-form"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><input required type="date" name="appointment_date" min="<%= new Date().toISOString().slice(0,10) %>"><input required type="time" name="start_time"><button class="btn btn-primary btn-sm">Save new time</button></form></details><form method="post" action="/account/appointments/<%= a.id %>/cancel" onsubmit="return confirm('Cancel this appointment and release the time slot?')"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><button class="btn btn-danger-soft btn-sm">Cancel</button></form><a href="/book" class="text-button">Book another →</a></div><% } else { %><div class="appointment-actions"><a href="/book" class="btn btn-soft btn-sm">Book again</a><% if(a.status==='completed'){ %><a href="/gallery" class="text-button">Leave a review →</a><% } %></div><% } %></article><% }) %><% if(!appointments.length){ %><div class="empty-state"><span>◫</span><h3>No appointments yet</h3><p>Your confirmed bookings will appear here.</p><a href="/book" class="btn btn-primary">Book your first visit</a></div><% } %></div></section></div></main><%- include('../partials/footer') %>
