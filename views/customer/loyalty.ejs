<%- include('../partials/head') %><%- include('../partials/header') %><%- include('../partials/flash') %><main id="main-content" class="account-page"><div class="container account-layout"><%- include('../partials/customer-sidebar') %><section class="account-content"><div class="account-head"><div><p class="eyebrow">VELOURA CIRCLE</p><h1>Membership & loyalty</h1><p>Track your current plan, savings and available points.</p></div></div><div class="loyalty-hero"><div><small>AVAILABLE POINTS</small><h2><%= customer.loyalty_points.toLocaleString() %></h2><p>Earned automatically from eligible completed appointments and purchases.</p></div><div><small>CURRENT MEMBERSHIP</small><h2><%= membership?.name||'No active plan' %></h2><p><%= membership?`${membership.discount_percent}% service savings · ${membership.points_multiplier}× points`:'Choose a plan to unlock member benefits.' %></p></div></div><div class="membership-grid compact-grid"><% memberships.forEach(m=>{ %><article class="membership-card <%= membership?.id===m.id?'active-plan':'' %>"><% if(membership?.id===m.id){ %><span class="recommended">CURRENT PLAN</span><% } %><p class="eyebrow"><%= m.name %></p><h2><%= money(m.price_monthly) %><small>/month</small></h2><div class="membership-value"><b><%= m.discount_percent %>%</b><span>savings</span><b><%= m.points_multiplier %>×</b><span>points</span></div><ul><% m.benefits.split('|').forEach(b=>{ %><li>✓ <%= b %></li><% }) %></ul><% if(membership?.id!==m.id){ %><form method="post" action="/memberships/<%= m.id %>/join"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><button class="btn btn-primary btn-block">Switch to <%= m.name %></button></form><% } %></article><% }) %></div></section></div></main><%- include('../partials/footer') %>
