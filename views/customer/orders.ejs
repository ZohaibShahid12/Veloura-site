<%- include('../partials/head') %><%- include('../partials/header') %><%- include('../partials/flash') %><main id="main-content" class="account-page"><div class="container account-layout"><%- include('../partials/customer-sidebar') %><section class="account-content"><div class="account-head"><div><p class="eyebrow">BEAUTY SHOP</p><h1>Product orders</h1><p>Track purchases, fulfilment and payment status.</p></div><a class="btn btn-primary" href="/shop">Shop products</a></div><div class="panel table-panel"><div class="table-wrap table-responsive"><table class="table align-middle mb-0"><thead><tr><th>Order</th><th>Date</th><th>Fulfilment</th><th>Status</th><th>Payment</th><th>Total</th></tr></thead><tbody><% orders.forEach(o=>{ %><tr><td><b><%= o.order_code %></b></td><td><%= dateTimeFmt(o.created_at) %></td><td><%= o.fulfillment %></td><td><span class="status <%= o.status %>"><%= o.status %></span></td><td><span class="status <%= o.payment_status %>"><%= o.payment_status %></span></td><td><b><%= money(o.total) %></b></td></tr><% }) %></tbody></table></div><% if(!orders.length){ %><div class="empty-state"><span>◇</span><h3>No product orders yet</h3><a href="/shop" class="btn btn-primary">Explore the shop</a></div><% } %></div></section></div></main><%- include('../partials/footer') %>
