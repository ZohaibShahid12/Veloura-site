<%- include('../partials/head') %><%- include('../partials/header') %><%- include('../partials/flash') %><main id="main-content" class="account-page"><div class="container account-layout"><%- include('../partials/customer-sidebar') %><section class="account-content"><div class="account-head"><div><p class="eyebrow">MY VELOURA</p><h1>Welcome back, <%= user.name.split(' ')[0] %>.</h1><p>Your appointments, membership and beauty history in one place.</p></div><a class="btn btn-primary" href="/book">Book appointment</a></div><div class="kpi-grid four"><article><span>Upcoming</span><b><%= upcoming.length %></b><small>appointments shown</small></article><article><span>Loyalty points</span><b><%= customer.loyalty_points.toLocaleString() %></b><small>available balance</small></article><article><span>Membership</span><b class="kpi-text"><%= membership?.name||'None' %></b><small><%= membership?`${membership.discount_percent}% service saving`:'Explore membership plans' %></small></article><article><span>Notifications</span><b><%= unread %></b><small>unread updates</small></article></div><div class="account-grid"><section class="panel span-2"><div class="panel-head"><div><p class="eyebrow">UPCOMING</p><h2>Your next appointments</h2></div><a href="/account/appointments">View all</a></div><% upcoming.forEach(a=>{ %><article class="appointment-row"><div class="date-box"><b><%= String(a.appointment_date).slice(8,10) %></b><span><%= dateFmt(a.appointment_date).split(' ')[1] %></span></div><div><h3><%= a.services %></h3><p><%= a.branch_name %> · <%= a.staff_name %></p><small><%= a.start_time %> — <%= a.end_time %></small></div><span class="status <%= a.status %>"><%= a.status %></span></article><% }) %><% if(!upcoming.length){ %><div class="empty-inline"><p>No upcoming appointment.</p><a href="/book">Reserve your next visit →</a></div><% } %></section><aside class="panel membership-panel"><p class="eyebrow"><%= membership?'MEMBERSHIP ACTIVE':'VELOURA CIRCLE' %></p><h2><%= membership?.name||'Unlock member privileges' %></h2><p><%= membership?membership.benefits.split('|').slice(0,3).join(' · '):'Earn more points, receive priority access and enjoy preferred pricing.' %></p><a class="btn btn-gold btn-block" href="/account/loyalty"><%= membership?'View benefits':'Explore plans' %></a></aside><section class="panel"><div class="panel-head"><div><p class="eyebrow">BEAUTY PROFILE</p><h2>Care preferences</h2></div><a href="/account/profile">Edit</a></div><dl class="profile-list"><div><dt>Skin type</dt><dd><%= customer.skin_type||'Not added' %></dd></div><div><dt>Hair type</dt><dd><%= customer.hair_type||'Not added' %></dd></div><div><dt>Preferred branch</dt><dd><%= customer.favourite_branch_id?'Saved':'Not selected' %></dd></div><div><dt>Allergy note</dt><dd><%= customer.allergies||'None saved' %></dd></div></dl></section><section class="panel"><div class="panel-head"><div><p class="eyebrow">RECENT ORDERS</p><h2>Beauty shop</h2></div><a href="/account/orders">View all</a></div><% recentOrders.forEach(o=>{ %><div class="order-mini"><div><b><%= o.order_code %></b><small><%= dateTimeFmt(o.created_at) %></small></div><div><b><%= money(o.total) %></b><span class="status <%= o.status %>"><%= o.status %></span></div></div><% }) %><% if(!recentOrders.length){ %><div class="empty-inline"><p>No product orders yet.</p><a href="/shop">Explore the beauty shop →</a></div><% } %></section><section class="panel span-2"><div class="panel-head"><div><p class="eyebrow">DIGITAL CONSULTATION</p><h2>Share your current goals</h2></div></div><form method="post" action="/account/consultation" class="premium-form"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><div class="form-row"><label>Skin concerns<input name="skin_concerns" placeholder="Dryness, sensitivity, pigmentation..."></label><label>Hair concerns<input name="hair_concerns" placeholder="Damage, colour, scalp..."></label></div><label>Beauty goals<textarea name="goals" rows="3" placeholder="What result would you like to work toward?"></textarea></label><div class="form-row"><label>Previous treatments<input name="previous_treatments"></label><label>Preferred follow-up<input type="date" name="follow_up_date"></label></div><label class="check-line"><input type="checkbox" name="consent" required>I consent to securely storing this consultation for authorised salon staff.</label><button class="btn btn-primary">Save consultation</button></form></section></div></section></div></main><%- include('../partials/footer') %>
