<%- include('../partials/head') %><%- include('../partials/header') %><%- include('../partials/flash') %><main id="main-content" class="account-page"><div class="container account-layout"><%- include('../partials/customer-sidebar') %><section class="account-content"><div class="account-head"><div><p class="eyebrow">PERSONAL LIBRARY</p><h1>Saved, gifts & consultations</h1><p>Your saved products, purchased gift cards and consultation history.</p></div></div><div class="account-grid"><section class="panel span-2"><div class="panel-head"><div><p class="eyebrow">WISHLIST</p><h2>Saved beauty products</h2></div><a href="/shop">Browse shop</a></div><div class="product-grid account-products"><% wishlist.forEach(p=>{ %><article class="product-card"><a href="/product/<%= p.slug %>"><img src="<%= p.image %>" alt="<%= p.name %>"></a><div><small><%= p.brand %></small><h3><a href="/product/<%= p.slug %>"><%= p.name %></a></h3><div class="product-meta"><b><%= money(p.price) %></b><span><%= p.stock %> in stock</span></div></div></article><% }) %></div><% if(!wishlist.length){ %><div class="empty-inline">No saved products yet.</div><% } %></section><aside class="panel"><p class="eyebrow">GIFT CARDS</p><h2>Purchased gifts</h2><% giftCards.forEach(g=>{ %><div class="address-card"><b><%= g.code %></b><p>For <%= g.recipient_name %> · <%= money(g.balance) %> balance</p><span class="status <%= g.status %>"><%= g.status %></span></div><% }) %><% if(!giftCards.length){ %><p class="muted">No purchased gift cards.</p><a href="/gift-cards" class="text-button">Create a gift →</a><% } %></aside><section class="panel span-3"><div class="panel-head"><div><p class="eyebrow">CONSULTATION HISTORY</p><h2>Beauty goals and follow-ups</h2></div></div><% consultations.forEach(c=>{ %><article class="consultation-card"><div><b><%= dateTimeFmt(c.created_at) %></b><span class="status <%= c.consent?'confirmed':'warning' %>"><%= c.consent?'consent recorded':'consent missing' %></span></div><p><strong>Skin:</strong> <%= c.skin_concerns||'—' %></p><p><strong>Hair:</strong> <%= c.hair_concerns||'—' %></p><p><strong>Goals:</strong> <%= c.goals||'—' %></p><p><strong>Follow-up:</strong> <%= dateFmt(c.follow_up_date) %></p></article><% }) %><% if(!consultations.length){ %><div class="empty-inline">No consultations saved yet.</div><% } %></section></div></section></div></main><%- include('../partials/footer') %>
