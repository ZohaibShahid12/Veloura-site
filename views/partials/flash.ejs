<% if(success){ %><div class="toast toast-success" role="status"><span>✓</span><%= success %><button type="button" aria-label="Close" onclick="this.parentElement.remove()">×</button></div><% } %>
<% if(error){ %><div class="toast toast-error" role="alert"><span>!</span><%= error %><button type="button" aria-label="Close" onclick="this.parentElement.remove()">×</button></div><% } %>
