<header class="site-header" id="siteHeader">
  <div class="announcement" role="status">
    <span>Complimentary consultation with selected luxury services</span>
    <span class="announcement-hide">Islamabad · Lahore · Rawalpindi</span>
  </div>

  <div class="container nav-row navbar navbar-expand-xl" aria-label="Website header">
    <a class="brand navbar-brand" href="/" aria-label="Veloura home">
      <span class="brand-mark" aria-hidden="true">V</span>
      <span class="brand-copy"><b>VELOURA</b><small>BEAUTY ATELIER</small></span>
    </a>

    <button class="menu-toggle navbar-toggler" type="button" aria-label="Open navigation" aria-controls="primaryNavigation" aria-expanded="false" data-menu-toggle>
      <span></span><span></span><span></span>
    </button>

    <nav class="main-nav" id="primaryNavigation" data-mobile-menu aria-label="Primary navigation">
      <ul class="nav-list navbar-nav">
        <li class="nav-item"><a href="/services" class="nav-link <%= currentPath.startsWith('/services')?'active':'' %>">Services</a></li>
        <li class="nav-item"><a href="/experts" class="nav-link <%= currentPath==='/experts'?'active':'' %>">Experts</a></li>
        <li class="nav-item"><a href="/bridal" class="nav-link <%= currentPath==='/bridal'?'active':'' %>">Bridal</a></li>
        <li class="nav-item"><a href="/packages" class="nav-link <%= currentPath==='/packages'?'active':'' %>">Packages</a></li>
        <li class="nav-item"><a href="/memberships" class="nav-link <%= currentPath==='/memberships'?'active':'' %>">Membership</a></li>
        <li class="nav-item"><a href="/shop" class="nav-link <%= currentPath.startsWith('/shop')||currentPath.startsWith('/product')?'active':'' %>">Shop</a></li>
        <li class="nav-item"><a href="/gallery" class="nav-link <%= currentPath==='/gallery'?'active':'' %>">Gallery</a></li>
        <li class="nav-item mobile-account-links">
          <div class="mobile-account-grid">
            <% if(user){ %>
              <a href="<%= ['admin','manager','receptionist'].includes(user.role)?'/admin':user.role==='staff'?'/staff':'/account' %>">Dashboard</a>
              <a href="/logout">Sign out</a>
            <% } else { %>
              <a href="/login">Sign in</a>
              <a href="/register">Create account</a>
            <% } %>
            <a class="mobile-book-link" href="/book">Book appointment</a>
          </div>
        </li>
      </ul>
    </nav>

    <div class="nav-actions d-flex align-items-center">
      <a class="icon-link cart-link" href="/cart" aria-label="View shopping bag">Bag <span><%= cartCount %></span></a>
      <% if(user){ %>
        <a class="account-chip" href="<%= ['admin','manager','receptionist'].includes(user.role)?'/admin':user.role==='staff'?'/staff':'/account' %>"><span><%= user.name.slice(0,1) %></span><b><%= user.name.split(' ')[0] %></b></a>
      <% } else { %>
        <a class="text-link" href="/login">Sign in</a>
      <% } %>
      <a class="btn btn-primary btn-sm nav-book-button" href="/book">Book appointment</a>
    </div>
  </div>

  <div class="responsive-quick-actions container" aria-label="Quick actions">
    <% if(user){ %>
      <a class="quick-account-link" href="<%= ['admin','manager','receptionist'].includes(user.role)?'/admin':user.role==='staff'?'/staff':'/account' %>">Dashboard</a>
    <% } else { %>
      <a class="quick-account-link" href="/login">Sign in</a>
    <% } %>
    <a class="quick-book-link" href="/book">Book appointment</a>
  </div>

  <button class="menu-backdrop" type="button" aria-label="Close navigation" tabindex="-1" data-menu-backdrop></button>
</header>
