<%- include('../partials/head') %><main class="auth-page" id="main-content"><div class="auth-visual register-visual"><a class="brand brand-light" href="/"><span class="brand-mark">V</span><span><b>VELOURA</b><small>BEAUTY ATELIER</small></span></a><div><p class="eyebrow light">JOIN VELOURA</p><h1>Personal care becomes effortless when we remember the details.</h1><p>Create an account to manage bookings, addresses, loyalty, purchases and consultation history.</p></div></div><div class="auth-panel"><%- include('../partials/flash') %><a class="back-link" href="/">← Back to website</a><div class="auth-card"><p class="eyebrow">CREATE ACCOUNT</p><h2>Begin your profile</h2><form method="post" action="/register" class="premium-form"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><label>Full name<input required name="name" autocomplete="name"></label><div class="form-row"><label>Email<input required type="email" name="email" autocomplete="email"></label><label>Phone<input required name="phone" autocomplete="tel"></label></div><label>Password<div class="password-field"><input required type="password" name="password" minlength="8" autocomplete="new-password"><button type="button" data-password-toggle>Show</button></div></label><label class="check-line"><input required type="checkbox">I agree to the privacy and appointment policies.</label><button class="btn btn-primary btn-lg btn-block">Create secure account</button></form><p class="auth-switch">Already registered? <a href="/login">Sign in</a></p></div></div></main></body></html>
