<%- include('../partials/head') %><%- include('../partials/header') %><%- include('../partials/flash') %><main id="main-content" class="staff-page"><div class="container"><div class="staff-hero"><div><p class="eyebrow light">STAFF WORKSPACE</p><h1>Good day, <%= user.name.split(' ')[0] %>.</h1><p><%= staff.title %> · <%= staff.branch_name %></p></div><form action="/staff/attendance" method="post"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><button class="btn btn-gold">Check in / out</button></form></div><div class="kpi-grid four floating-kpis"><article><span>Upcoming</span><b><%= appointments.length %></b><small>assigned appointments</small></article><article><span>Rating</span><b><%= staff.rating %></b><small>guest average</small></article><article><span>Monthly commission</span><b class="kpi-text"><%= money(commission) %></b><small><%= staff.commission_rate %>% rate</small></article><article><span>Working hours</span><b class="kpi-text"><%= staff.start_time %>–<%= staff.end_time %></b><small>scheduled shift</small></article></div><div class="staff-layout"><section class="panel span-2"><div class="panel-head"><div><p class="eyebrow">ASSIGNED SCHEDULE</p><h2>Upcoming appointments</h2></div><span class="tag"><%= dateFmt(today) %></span></div><div class="staff-appointments"><% appointments.forEach(a=>{ %><article><div class="time-column"><b><%= a.start_time %></b><span><%= a.end_time %></span></div><div class="staff-appt-main"><div><span class="status <%= a.status %>"><%= a.status %></span><h3><%= a.customer_name %></h3><p><%= a.services %></p><small><%= dateFmt(a.appointment_date) %> · <%= a.customer_phone %> · <%= money(a.total) %></small></div><details><summary class="btn btn-soft btn-sm">Manage</summary><div class="staff-action-menu"><form method="post" action="/staff/appointments/<%= a.id %>/status"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><select name="status"><option value="checked-in">Checked in</option><option value="in-service">Start service</option><option value="paused">Pause</option><option value="completed">Complete</option><option value="needs-follow-up">Needs follow-up</option></select><button class="btn btn-primary btn-sm">Update</button></form><form method="post" action="/staff/appointments/<%= a.id %>/notes"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><textarea name="note" placeholder="Treatment notes" rows="2"></textarea><input name="formula" placeholder="Formula / shade"><input name="used_products" placeholder="Products used"><button class="btn btn-soft btn-sm">Save notes</button></form></div></details></div></article><% }) %><% if(!appointments.length){ %><div class="empty-state"><span>◫</span><h3>No upcoming appointments</h3><p>Your assigned schedule will appear here.</p></div><% } %></div></section><aside class="panel"><p class="eyebrow">REQUEST LEAVE</p><h2>Time away</h2><form action="/staff/leave" method="post" class="premium-form"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><label>Start date<input required type="date" name="start_date"></label><label>End date<input required type="date" name="end_date"></label><label>Reason<textarea name="reason" rows="3"></textarea></label><button class="btn btn-primary btn-block">Submit request</button></form><div class="leave-history"><h3>Recent requests</h3><% leave.forEach(l=>{ %><div><span><%= dateFmt(l.start_date) %>–<%= dateFmt(l.end_date) %></span><b class="status <%= l.status %>"><%= l.status %></b></div><% }) %></div></aside><aside class="panel"><p class="eyebrow">SERVICE STANDARDS</p><h2>Before every guest</h2><ul class="check-list"><li>Review allergies and treatment history</li><li>Confirm service goals and expectations</li><li>Record formulas and products used</li><li>Update appointment status accurately</li><li>Share aftercare and next-visit guidance</li></ul></aside></div></div></main><%- include('../partials/footer') %>
