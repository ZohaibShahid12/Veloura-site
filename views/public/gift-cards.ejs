<%- include('../partials/head') %><%- include('../partials/header') %><%- include('../partials/flash') %><main id="main-content"><section class="gift-hero"><div class="container gift-layout"><div><p class="eyebrow light">THE GIFT OF VELOURA</p><h1>A beautiful reason to pause.</h1><p>Send a digital beauty gift with a personal message, flexible balance and one-year validity.</p><div class="gift-preview"><span class="brand-mark">V</span><div><small>VELOURA GIFT</small><h3>For a beautifully considered moment</h3><b>PKR 10,000</b></div></div></div><form class="gift-form" action="/gift-cards" method="post"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><h2>Create a gift card</h2><div class="form-row"><label>Your name<input required name="name" value="<%= customer?.name||'' %>"></label><label>Your phone<input required name="phone" value="<%= customer?.phone||'' %>"></label></div><label>Your email<input required type="email" name="email" value="<%= customer?.email||'' %>"></label><div class="form-row"><label>Recipient name<input required name="recipient_name"></label><label>Recipient email<input required type="email" name="recipient_email"></label></div><label>Gift amount<select name="amount"><option value="5000">PKR 5,000</option><option value="10000" selected>PKR 10,000</option><option value="20000">PKR 20,000</option><option value="50000">PKR 50,000</option></select></label><label>Personal message<textarea name="message" rows="3"></textarea></label><label>Payment method<select name="payment_method"><option>Card</option><option>Easypaisa</option><option>JazzCash</option><option>Bank Transfer</option></select></label><button class="btn btn-gold btn-lg btn-block">Purchase gift card</button></form></div></section></main><%- include('../partials/footer') %>
