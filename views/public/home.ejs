<%- include('../partials/head') %><%- include('../partials/header') %><%- include('../partials/flash') %>
<main id="main-content">
<section class="hero">
  <div class="hero-image"><div class="hero-overlay"></div></div>
  <div class="container hero-content reveal"><p class="eyebrow light">LUXURY BEAUTY, THOUGHTFULLY PERSONAL</p><h1>Beauty that feels<br><em>distinctly yours.</em></h1><p>Expert-led hair, skin, makeup and bridal experiences shaped around your features, preferences and pace.</p><div class="hero-actions"><a class="btn btn-gold" href="/book">Book your appointment</a><a class="btn btn-ghost-light" href="/services">Explore services</a></div><div class="hero-meta"><span><b>4.9/5</b> verified guest rating</span><span><b>3</b> signature locations</span><span><b>20+</b> curated treatments</span></div></div>
</section>
<section class="section service-preview"><div class="container"><div class="section-heading split"><div><p class="eyebrow">THE VELOURA EDIT</p><h2>Rituals for every expression</h2></div><a class="arrow-link" href="/services">View all services <span>→</span></a></div><div class="card-grid four"><% services.forEach((service,i)=>{ %><article class="service-card reveal" style="--delay:<%= i*50 %>ms"><a href="/services/<%= service.slug %>" class="image-wrap"><img src="<%= service.image %>" alt="<%= service.name %>" loading="lazy"><span class="price-pill"><%= money(service.price) %></span></a><div><p class="card-kicker"><%= service.category_name %> · <%= service.duration %> min</p><h3><a href="/services/<%= service.slug %>"><%= service.name %></a></h3><p><%= service.description %></p><a href="/book?service=<%= service.id %>" class="text-button">Reserve <span>→</span></a></div></article><% }) %></div></div></section>
<section class="editorial-section"><div class="editorial-image reveal"><img src="https://images.unsplash.com/photo-1560066984-138dadb4c035?auto=format&fit=crop&w=1500&q=85" alt="Luxury salon interior" loading="lazy"></div><div class="editorial-copy reveal"><p class="eyebrow">THE ATELIER EXPERIENCE</p><h2>More than an appointment.</h2><p>We remember the details that make each visit effortless—from preferred shades and styling notes to refreshments, privacy and aftercare.</p><div class="feature-list"><div><span>01</span><div><b>Considered consultation</b><p>Your history, goals and comfort guide every recommendation.</p></div></div><div><span>02</span><div><b>Expert continuity</b><p>Rebook trusted professionals with your service notes securely preserved.</p></div></div><div><span>03</span><div><b>Personal aftercare</b><p>Receive practical guidance and product recommendations that suit you.</p></div></div></div><a class="btn btn-primary" href="/book">Begin your experience</a></div></section>
<section class="section blush-section"><div class="container"><div class="section-heading centered"><p class="eyebrow">CURATED JOURNEYS</p><h2>Packages made for meaningful moments</h2><p>Thoughtfully combined services, coordinated timings and preferred pricing.</p></div><div class="card-grid four"><% packages.forEach((p,i)=>{ %><article class="package-card reveal" style="--delay:<%= i*70 %>ms"><img src="<%= p.image %>" alt="<%= p.name %>" loading="lazy"><div><span><%= p.category %></span><h3><%= p.name %></h3><p><%= p.description %></p><div class="package-price"><b><%= money(p.price) %></b><del><%= money(p.original_price) %></del></div><a href="/packages" class="text-button">Explore package →</a></div></article><% }) %></div></div></section>
<section class="section"><div class="container"><div class="section-heading split"><div><p class="eyebrow">THE ARTISTS</p><h2>Meet your beauty experts</h2></div><a href="/experts" class="arrow-link">Meet the full team →</a></div><div class="expert-grid"><% experts.forEach((e,i)=>{ %><article class="expert-card reveal" style="--delay:<%= i*60 %>ms"><img src="<%= e.image %>" alt="<%= e.name %>" loading="lazy"><div class="expert-overlay"><span>★ <%= e.rating %></span><h3><%= e.name %></h3><p><%= e.title %></p><small><%= e.branch_name %></small><a href="/book?staff=<%= e.id %>">Book with <%= e.name.split(' ')[0] %> →</a></div></article><% }) %></div></div></section>
<section class="membership-band"><div class="container membership-inner reveal"><div><p class="eyebrow light">VELOURA CIRCLE</p><h2>Beauty, with privileges.</h2><p>Priority access, preferred pricing, birthday rituals and loyalty rewards designed for regular care.</p></div><div class="membership-benefits"><span>Priority booking</span><span>Up to 20% savings</span><span>Points on every visit</span><span>VIP preferences</span></div><a class="btn btn-gold" href="/memberships">View memberships</a></div></section>
<section class="section"><div class="container"><div class="section-heading split"><div><p class="eyebrow">AT-HOME AFTERCARE</p><h2>The beauty shelf</h2></div><a href="/shop" class="arrow-link">Shop all products →</a></div><div class="product-grid"><% products.forEach((p,i)=>{ %><article class="product-card reveal"><a href="/product/<%= p.slug %>"><img src="<%= p.image %>" alt="<%= p.name %>" loading="lazy"></a><div><small><%= p.brand %></small><h3><a href="/product/<%= p.slug %>"><%= p.name %></a></h3><div class="product-meta"><b><%= money(p.price) %></b><span>★ <%= p.rating %></span></div><form action="/cart/add" method="post"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><input type="hidden" name="product_id" value="<%= p.id %>"><button class="btn btn-soft btn-block">Add to bag</button></form></div></article><% }) %></div></div></section>
<section class="section testimonials"><div class="container"><div class="section-heading centered"><p class="eyebrow">GUEST NOTES</p><h2>What our guests remember</h2></div><div class="testimonial-grid"><% reviews.forEach(r=>{ %><blockquote class="reveal"><div class="stars">★★★★★</div><p>“<%= r.comment %>”</p><footer><span><%= r.customer_name %></span><small><%= r.service_name %> · Verified guest</small></footer></blockquote><% }) %></div></div></section>
<section class="section locations"><div class="container"><div class="section-heading centered"><p class="eyebrow">VISIT VELOURA</p><h2>Three ateliers, one standard of care</h2></div><div class="location-grid"><% branches.forEach((b,i)=>{ %><article class="location-card reveal"><span>0<%= i+1 %></span><h3><%= b.name %></h3><p><%= b.address %></p><p><%= b.opening_time %> — <%= b.closing_time %></p><a href="/book?branch=<%= b.id %>">Book this location →</a></article><% }) %></div></div></section>
</main><%- include('../partials/footer') %>
