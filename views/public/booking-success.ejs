<%- include('../partials/head') %><%- include('../partials/header') %><main id="main-content"><section class="success-page"><div class="success-icon">✓</div><p class="eyebrow">APPOINTMENT CONFIRMED</p><h1>We look forward to welcoming you.</h1><p>Your booking has been saved across the customer, staff and management dashboards.</p><div class="appointment-ticket"><div class="ticket-head"><span class="brand-mark">V</span><div><small>BOOKING</small><b><%= appointment.booking_code %></b></div><span class="status confirmed"><%= appointment.status %></span></div><div class="ticket-grid"><div><small>Guest</small><b><%= appointment.customer_name %></b></div><div><small>Date</small><b><%= dateFmt(appointment.appointment_date) %></b></div><div><small>Time</small><b><%= appointment.start_time %> — <%= appointment.end_time %></b></div><div><small>Branch</small><b><%= appointment.branch_name %></b></div><div><small>Expert</small><b><%= appointment.staff_name %></b></div><div><small>Services</small><b><%= appointment.services.map(s=>s.name).join(', ') %></b></div><div><small>Total</small><b><%= money(appointment.total) %></b></div><div><small>Deposit</small><b><%= money(appointment.deposit) %></b></div></div></div><div class="success-actions"><% if(customer){ %><a class="btn btn-primary" href="/account/appointments">View appointments</a><% } %><a class="btn btn-soft" href="/services">Explore more services</a></div></section></main><%- include('../partials/footer') %>
