<%- include('../partials/head') %><%- include('../partials/header') %><%- include('../partials/flash') %><main id="main-content">
<section class="detail-hero"><div class="detail-image"><img src="<%= service.image %>" alt="<%= service.name %>"></div><div class="detail-copy"><p class="eyebrow"><%= service.category_name %></p><h1><%= service.name %></h1><div class="rating-line"><span>★★★★★</span><b><%= service.rating %></b><small><%= reviews.length %> reviews</small></div><p class="lead"><%= service.description %></p><div class="service-facts"><div><small>Investment</small><b><%= money(service.price) %></b></div><div><small>Time</small><b><%= service.duration %> minutes</b></div><div><small>Home service</small><b><%= service.home_service?'Available':'Salon only' %></b></div></div><a class="btn btn-primary btn-lg" href="/book?service=<%= service.id %>">Book this service</a></div></section>
<% if(service.category_slug==='massage-wellness' || service.category_slug==='bridal'){ const isMassage=service.category_slug==='massage-wellness'; %><section class="detail-film-section"><div class="container"><div class="detail-film reveal"><video autoplay muted loop playsinline controls poster="<%= isMassage?'/media/massage-wellness-film-poster.jpg':'/media/bridal-atelier-film-poster.jpg' %>"><source src="<%= isMassage?'/media/massage-wellness-film.mp4':'/media/bridal-atelier-film.mp4' %>" type="video/mp4"></video><div><p class="eyebrow"><%= isMassage?'A MOMENT TO RESET':'THE BRIDAL STORY' %></p><h2><%= isMassage?'See the wellness ritual':'See the artistry unfold' %></h2><p><%= isMassage?'A quiet preview of the atmosphere, pace and personalised care behind our massage experiences.':'A cinematic introduction to our coordinated makeup, hair and bridal preparation experience.' %></p><a class="text-button" href="<%= isMassage?'/services?category=massage-wellness':'/bridal' %>"><%= isMassage?'View all massage services':'Explore the Bridal Atelier' %> →</a></div></div></div></section><% } %>
<section class="section"><div class="container detail-columns"><div><p class="eyebrow">WHAT TO EXPECT</p><h2>A polished experience from consultation to finish.</h2><div class="prose"><p>Your expert begins with a focused consultation, considers your preferences and service history, then adapts the treatment to suit your needs.</p><h3>Benefits</h3><ul><li>Personalised expert consultation</li><li>Premium professional products</li><li>Clear preparation and aftercare guidance</li><li>Service notes saved for easier rebooking</li></ul><h3>Before your appointment</h3><p>Arrive ten minutes early and share allergies, sensitivities, recent treatments or inspiration references during booking.</p><h3>Aftercare</h3><p>Your expert will provide practical care guidance and recommend only products relevant to your result.</p></div></div><aside class="sticky-card"><p class="eyebrow">AVAILABLE EXPERTS</p><% experts.forEach(e=>{ %><div class="mini-expert"><img src="<%= e.image %>" alt="<%= e.name %>"><div><b><%= e.name %></b><small><%= e.title %> · ★ <%= e.rating %></small><span><%= e.branch_name %></span></div></div><% }) %><a class="btn btn-primary btn-block" href="/book?service=<%= service.id %>">Check available times</a></aside></div></section>
<% if(reviews.length){ %><section class="section blush-section"><div class="container"><div class="section-heading"><p class="eyebrow">VERIFIED REVIEWS</p><h2>Guest experiences</h2></div><div class="testimonial-grid"><% reviews.forEach(r=>{ %><blockquote><div class="stars">★★★★★</div><p>“<%= r.comment %>”</p><footer><span><%= r.customer_name %></span><small><%= r.verified?'Verified appointment':'Guest review' %></small></footer></blockquote><% }) %></div></div></section><% } %>
<section class="section"><div class="container"><div class="section-heading split"><div><p class="eyebrow">YOU MAY ALSO LIKE</p><h2>Complete your ritual</h2></div></div><div class="card-grid four"><% related.forEach(s=>{ %><article class="service-card"><a href="/services/<%= s.slug %>" class="image-wrap"><img src="<%= s.image %>" alt="<%= s.name %>"></a><div><h3><a href="/services/<%= s.slug %>"><%= s.name %></a></h3><div class="product-meta"><b><%= money(s.price) %></b><span><%= s.duration %> min</span></div></div></article><% }) %></div></div></section></main><%- include('../partials/footer') %>
