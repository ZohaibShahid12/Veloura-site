<%- include('../partials/head') %><%- include('../partials/header') %><%- include('../partials/flash') %><main id="main-content"><section class="booking-page"><div class="booking-intro"><p class="eyebrow light">RESERVE YOUR TIME</p><h1>Your next Veloura experience begins here.</h1><p>Choose services, location, expert and a live available time. Your deposit is processed in sandbox mode for this ready-to-run build.</p><div class="booking-trust"><span>✓ Real availability</span><span>✓ Double-booking prevention</span><span>✓ Instant confirmation</span></div></div><div class="booking-shell" data-booking-app><div class="booking-progress"><button class="active" type="button" data-step-dot="1"><span>1</span>Visit</button><button type="button" data-step-dot="2"><span>2</span>Services</button><button type="button" data-step-dot="3"><span>3</span>Time</button><button type="button" data-step-dot="4"><span>4</span>Details</button><button type="button" data-step-dot="5"><span>5</span>Confirm</button></div><form action="/book" method="post" id="bookingForm"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><section class="booking-step active" data-step="1"><p class="eyebrow">STEP 1</p><h2>How would you like to visit?</h2><div class="choice-grid two"><label class="choice-card"><input type="radio" name="visit_type" value="salon" checked><span>✦</span><b>Salon appointment</b><small>Visit one of our signature ateliers</small></label><label class="choice-card"><input type="radio" name="visit_type" value="home"><span>⌂</span><b>Home service</b><small>Selected services with a travel fee</small></label></div><label>Choose branch<select name="branch_id" id="branchSelect" required><option value="">Select a location</option><% branches.forEach(b=>{ %><option value="<%= b.id %>" <%= Number(new URLSearchParams('').get?.('branch'))===b.id?'selected':'' %>><%= b.name %> — <%= b.city %></option><% }) %></select></label><div class="step-actions"><span></span><button type="button" class="btn btn-primary" data-next>Continue</button></div></section><section class="booking-step" data-step="2"><p class="eyebrow">STEP 2</p><h2>Select one or more services.</h2><div class="service-select-list"><% services.forEach(s=>{ %><label class="service-choice"><input type="checkbox" name="service_ids" value="<%= s.id %>" data-price="<%= s.price %>" data-duration="<%= s.duration %>" <%= selectedService===s.id?'checked':'' %>><img src="<%= s.image %>" alt=""><span><small><%= s.category_name %></small><b><%= s.name %></b><em><%= s.duration %> min · <%= money(s.price) %></em></span><i>✓</i></label><% }) %></div><div class="selection-summary"><span><b id="selectedCount">0</b> services</span><span><b id="selectedDuration">0</b> minutes</span><span><b id="selectedTotal">PKR 0</b></span></div><div class="step-actions"><button type="button" class="btn btn-soft" data-back>Back</button><button type="button" class="btn btn-primary" data-next>Choose expert & time</button></div></section><section class="booking-step" data-step="3"><p class="eyebrow">STEP 3</p><h2>Choose your expert and live time.</h2><div class="form-row"><label>Preferred expert<select name="staff_id" id="staffSelect"><option value="">Any available expert</option><% staff.forEach(s=>{ %><option value="<%= s.id %>" data-branch="<%= s.branch_id %>"><%= s.name %> — <%= s.title %> · <%= s.branch_name %></option><% }) %></select></label><label>Date<input id="bookingDate" name="appointment_date" type="date" min="<%= today %>" required></label></div><div><p class="label-title">Available time</p><div id="slotLoader" class="slot-loader">Choose a branch, services and date to load live availability.</div><div id="timeSlots" class="time-slots"></div><input type="hidden" name="start_time" id="startTime" required></div><div class="step-actions"><button type="button" class="btn btn-soft" data-back>Back</button><button type="button" class="btn btn-primary" data-next>Continue</button></div></section><section class="booking-step" data-step="4"><p class="eyebrow">STEP 4</p><h2>Your details and preferences.</h2><div class="form-row"><label>Full name<input required name="name" value="<%= customer?.name||'' %>"></label><label>Phone<input required name="phone" value="<%= customer?.phone||'' %>"></label></div><div class="form-row"><label>Email<input required type="email" name="email" value="<%= customer?.email||'' %>"></label><label>WhatsApp<input name="whatsapp" value="<%= customer?.whatsapp||customer?.phone||'' %>"></label></div><label class="home-address hidden" data-home-address>Home-service address<textarea name="address" rows="2"></textarea></label><label>Notes, allergies or goals<textarea name="notes" rows="4" placeholder="Share sensitivities, recent treatments, inspiration or luxury preferences."></textarea></label><div class="step-actions"><button type="button" class="btn btn-soft" data-back>Back</button><button type="button" class="btn btn-primary" data-next>Review booking</button></div></section><section class="booking-step" data-step="5"><p class="eyebrow">STEP 5</p><h2>Review and confirm.</h2><div class="review-booking" id="bookingReview"><p>Your booking summary will appear here.</p></div><div class="form-row"><label>Payment option<select name="payment_option"><option value="deposit">Pay 30% deposit</option><option value="full">Pay full amount</option></select></label><label>Payment method<select name="payment_method"><option>Card</option><option>Easypaisa</option><option>JazzCash</option><option>Bank Transfer</option></select></label></div><label class="check-line"><input required type="checkbox">I confirm the appointment details and cancellation policy.</label><div class="step-actions"><button type="button" class="btn btn-soft" data-back>Back</button><button type="submit" class="btn btn-gold btn-lg">Confirm appointment</button></div></section></form></div></section></main><%- include('../partials/footer') %>
