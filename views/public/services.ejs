<%- include('../partials/head') %><%- include('../partials/header') %><%- include('../partials/flash') %><main id="main-content">
<section class="page-hero compact"><div class="container"><p class="eyebrow">SERVICE MENU</p><h1>Expert beauty, curated for you.</h1><p>Explore considered treatments with transparent pricing, duration and specialist availability.</p></div></section>
<section class="section service-film-section"><div class="container"><div class="service-film-shell reveal"><div class="service-film-player"><video id="serviceFilm" autoplay muted loop playsinline controls poster="/media/massage-wellness-film-poster.jpg" aria-label="Veloura massage and bridal service film"><source src="/media/massage-wellness-film.mp4" type="video/mp4">Your browser does not support HTML video.</video><span class="film-badge">SIGNATURE SERVICE FILMS</span></div><div class="service-film-copy"><p class="eyebrow">SEE THE EXPERIENCE</p><h2 id="serviceFilmTitle">Massage &amp; Wellness</h2><p id="serviceFilmDescription">Step into a calm, considered ritual with personalised pressure, elegant surroundings and expert-led care.</p><div class="film-selector" role="tablist" aria-label="Choose service film"><button type="button" class="film-tab active" role="tab" aria-selected="true" data-service-film-button data-src="/media/massage-wellness-film.mp4" data-poster="/media/massage-wellness-film-poster.jpg" data-title="Massage &amp; Wellness" data-description="Step into a calm, considered ritual with personalised pressure, elegant surroundings and expert-led care." data-href="/services?category=massage-wellness"><span>01</span><b>Massage ritual</b></button><button type="button" class="film-tab" role="tab" aria-selected="false" data-service-film-button data-src="/media/bridal-atelier-film.mp4" data-poster="/media/bridal-atelier-film-poster.jpg" data-title="The Bridal Atelier" data-description="Preview a coordinated bridal journey shaped around your features, dress, jewellery and celebration." data-href="/bridal"><span>02</span><b>Bridal artistry</b></button></div><a id="serviceFilmCta" class="btn btn-primary" href="/services?category=massage-wellness">Explore massage services</a></div></div></div></section>
<section class="section top-tight"><div class="container listing-layout"><aside class="filter-panel"><div class="filter-head"><h3>Refine services</h3><a href="/services">Reset</a></div><form method="get" action="/services"><label>Search<input type="search" name="search" value="<%= filters.search %>" placeholder="Service or concern"></label><label>Category<select name="category"><option value="">All categories</option><% categories.forEach(c=>{ %><option value="<%= c.slug %>" <%= filters.category===c.slug?'selected':'' %>><%= c.name %></option><% }) %></select></label><label>Branch<select name="branch"><option value="">All branches</option><% branches.forEach(b=>{ %><option value="<%= b.id %>" <%= Number(filters.branch)===b.id?'selected':'' %>><%= b.name %></option><% }) %></select></label><label>Maximum price<select name="max_price"><option value="">Any price</option><option value="5000" <%= filters.maxPrice===5000?'selected':'' %>>Up to PKR 5,000</option><option value="10000" <%= filters.maxPrice===10000?'selected':'' %>>Up to PKR 10,000</option><option value="20000" <%= filters.maxPrice===20000?'selected':'' %>>Up to PKR 20,000</option></select></label><label>Minimum rating<select name="rating"><option value="">Any rating</option><option value="4.8" <%= filters.rating===4.8?'selected':'' %>>4.8+</option><option value="4.9" <%= filters.rating===4.9?'selected':'' %>>4.9+</option></select></label><button class="btn btn-primary btn-block">Apply filters</button></form></aside><div class="listing-main"><div class="results-bar"><p><b><%= services.length %></b> services available</p><button class="filter-toggle btn btn-soft btn-sm" data-filter-toggle>Filters</button></div><div class="card-grid three"><% services.forEach(s=>{ %><article class="service-card reveal"><a href="/services/<%= s.slug %>" class="image-wrap"><img src="<%= s.image %>" alt="<%= s.name %>" loading="lazy"><span class="price-pill"><%= money(s.price) %></span></a><div><p class="card-kicker"><%= s.category_name %> · <%= s.duration %> min · ★ <%= s.rating %></p><h3><a href="/services/<%= s.slug %>"><%= s.name %></a></h3><p><%= s.description %></p><div class="card-actions"><a href="/services/<%= s.slug %>" class="text-button">Details</a><a href="/book?service=<%= s.id %>" class="btn btn-primary btn-sm">Book</a></div></div></article><% }) %></div><% if(!services.length){ %><div class="empty-state"><span>✦</span><h3>No services match these filters</h3><p>Try widening your price, branch or category selection.</p><a class="btn btn-primary" href="/services">Clear filters</a></div><% } %></div></div></section></main><%- include('../partials/footer') %>
