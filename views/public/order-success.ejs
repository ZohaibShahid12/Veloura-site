<%- include('../partials/head') %><%- include('../partials/header') %><main id="main-content"><section class="success-page"><div class="success-icon">✓</div><p class="eyebrow">ORDER CONFIRMED</p><h1>Thank you, <%= order.name %>.</h1><p>Your order <b><%= order.order_code %></b> has been recorded and inventory has been updated.</p><div class="success-card"><div><small>Total</small><b><%= money(order.total) %></b></div><div><small>Status</small><b><%= order.status %></b></div><div><small>Fulfilment</small><b><%= order.fulfillment %></b></div><div><small>Payment</small><b><%= order.payment_status %></b></div></div><div class="success-actions"><a href="/shop" class="btn btn-primary">Continue shopping</a><% if(customer){ %><a href="/account/orders" class="btn btn-soft">View my orders</a><% } %></div></section></main><%- include('../partials/footer') %>
