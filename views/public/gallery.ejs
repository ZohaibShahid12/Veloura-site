<%- include('../partials/head') %><%- include('../partials/header') %><%- include('../partials/flash') %>
<main id="main-content">
  <section class="page-hero gallery-hero">
    <div class="container gallery-hero-inner">
      <p class="eyebrow">TRANSFORMATIONS &amp; STORIES</p>
      <h1>Every service, beautifully represented.</h1>
      <p>Explore real-inspired looks across bridal artistry, hair, skin, nails, massage and signature beauty rituals.</p>
      <div class="gallery-hero-tags" aria-label="Gallery categories">
        <a href="#hair">Hair</a><a href="#bridal">Bridal</a><a href="#skin">Skin</a><a href="#nails">Nails</a><a href="#wellness">Massage</a><a href="#makeup">Makeup</a>
      </div>
    </div>
  </section>

  <section class="section gallery-showcase-section top-tight">
    <div class="container">
      <div class="section-heading centered gallery-intro">
        <p class="eyebrow">THE VELOURA PORTFOLIO</p>
        <h2>Different services. One signature standard.</h2>
        <p>Each visual opens a path to the related salon experience, so guests can discover and book the treatment that suits them.</p>
      </div>

      <div class="gallery-mosaic">
        <a class="gallery-tile tile-xl" id="bridal" href="/bridal"><img src="https://images.unsplash.com/photo-1519741497674-611481863552?auto=format&fit=crop&w=1200&q=86" alt="Luxury bridal makeup and styling" loading="lazy"><span><b>Bridal Atelier</b><small>Makeup · Hair · Event planning</small></span></a>
        <a class="gallery-tile tile-tall" id="nails" href="/services?category=nails"><img src="https://images.unsplash.com/photo-1604654894610-df63bc536371?auto=format&fit=crop&w=900&q=86" alt="Luxury nail art manicure" loading="lazy"><span><b>Nail Art</b><small>Manicure · Extensions</small></span></a>
        <a class="gallery-tile tile-standard" id="makeup" href="/services?category=makeup"><img src="https://images.unsplash.com/photo-1487412720507-e7ab37603c6f?auto=format&fit=crop&w=900&q=86" alt="Professional makeup service" loading="lazy"><span><b>Signature Makeup</b><small>Party · HD · Airbrush</small></span></a>
        <a class="gallery-tile tile-wide" id="hair" href="/services?category=hair"><img src="https://images.unsplash.com/photo-1522337360788-8b13dee7a37e?auto=format&fit=crop&w=1200&q=86" alt="Professional salon hair styling" loading="lazy"><span><b>Hair Styling</b><small>Cut · Blow-dry · Finish</small></span></a>
        <a class="gallery-tile tile-standard" id="skin" href="/services?category=skin"><img src="https://images.unsplash.com/photo-1570172619644-dfd03ed5d881?auto=format&fit=crop&w=900&q=86" alt="Hydrating facial skincare service" loading="lazy"><span><b>Skin Rituals</b><small>Facials · Hydra glow</small></span></a>
        <a class="gallery-tile tile-wide" id="wellness" href="/services?category=massage-wellness"><img src="https://images.unsplash.com/photo-1544161515-4ab6ce6db874?auto=format&fit=crop&w=1200&q=86" alt="Professional back massage in spa" loading="lazy"><span><b>Massage &amp; Wellness</b><small>Relaxation · Deep tissue</small></span></a>
        <a class="gallery-tile tile-tall" href="/services"><img src="https://images.unsplash.com/photo-1562322140-8baeececf3df?auto=format&fit=crop&w=900&q=86" alt="Salon hair colour transformation" loading="lazy"><span><b>Colour Studio</b><small>Balayage · Highlights</small></span></a>
        <a class="gallery-tile tile-standard" href="/services"><img src="https://images.unsplash.com/photo-1571290274554-6a2eaa771e5f?auto=format&fit=crop&w=900&q=86" alt="Eyebrow and lash beauty service" loading="lazy"><span><b>Brows &amp; Lashes</b><small>Shape · Tint · Extensions</small></span></a>
        <a class="gallery-tile tile-standard" href="/services"><img src="https://images.unsplash.com/photo-1515377905703-c4788e51af15?auto=format&fit=crop&w=900&q=86" alt="Relaxing spa treatment" loading="lazy"><span><b>Body Rituals</b><small>Spa · Aromatherapy</small></span></a>
        <a class="gallery-tile tile-wide" href="/services"><img src="https://images.unsplash.com/photo-1516975080664-ed2fc6a32937?auto=format&fit=crop&w=1200&q=86" alt="Professional salon makeup palette and beauty styling" loading="lazy"><span><b>Occasion Beauty</b><small>Events · Celebrations</small></span></a>
        <a class="gallery-tile tile-standard" href="/services"><img src="https://images.unsplash.com/photo-1526045612212-70caf35c14df?auto=format&fit=crop&w=900&q=86" alt="Pedicure and foot care service" loading="lazy"><span><b>Hands &amp; Feet</b><small>Pedicure · Care</small></span></a>
        <a class="gallery-tile tile-xl" href="/packages"><img src="https://images.unsplash.com/photo-1560066984-138dadb4c035?auto=format&fit=crop&w=1200&q=86" alt="Luxury ladies salon interior and full service experience" loading="lazy"><span><b>The Full Salon Experience</b><small>Explore curated packages</small></span></a>
      </div>
    </div>
  </section>

  <section class="section gallery-services-section">
    <div class="container">
      <div class="section-heading split">
        <div><p class="eyebrow">DISCOVER BY SERVICE</p><h2>More ways to feel transformed.</h2></div>
        <a class="arrow-link" href="/services">View all services <span>→</span></a>
      </div>
      <div class="gallery-service-grid">
        <a href="/services?category=massage-wellness"><span>01</span><div><h3>Massage &amp; Wellness</h3><p>Full-body, Swedish, hot-stone and focused tension-release rituals.</p></div><b>Explore →</b></a>
        <a href="/bridal"><span>02</span><div><h3>Bridal Artistry</h3><p>Consultation-led makeup, hair, trials and coordinated event preparation.</p></div><b>Explore →</b></a>
        <a href="/services"><span>03</span><div><h3>Hair &amp; Colour</h3><p>Precision cuts, styling, highlights, balayage and restorative treatments.</p></div><b>Explore →</b></a>
        <a href="/services"><span>04</span><div><h3>Skin &amp; Facial Care</h3><p>Hydration, glow, barrier support and personalised advanced facial rituals.</p></div><b>Explore →</b></a>
        <a href="/services"><span>05</span><div><h3>Nails, Brows &amp; Lashes</h3><p>Detailed finishing services for polished hands, feet, brows and lashes.</p></div><b>Explore →</b></a>
        <a href="/packages"><span>06</span><div><h3>Curated Beauty Packages</h3><p>Multi-service journeys created for monthly care, occasions and gifting.</p></div><b>Explore →</b></a>
        <a href="/services?category=home-services"><span>07</span><div><h3>Home Salon Services</h3><p>Selected hair, makeup, nails and wellness services delivered with professional care.</p></div><b>Explore →</b></a>
        <a href="/memberships"><span>08</span><div><h3>Membership Beauty Benefits</h3><p>Priority appointments, member pricing, loyalty rewards and recurring self-care plans.</p></div><b>Explore →</b></a>
      </div>
    </div>
  </section>

  <section class="section review-section">
    <div class="container">
      <div class="section-heading centered review-heading"><p class="eyebrow">GUEST REVIEWS</p><h2>Every note helps us refine the experience.</h2></div>
      <div class="testimonial-grid"><% reviews.forEach(r=>{ %><blockquote><div class="stars"><%= '★'.repeat(r.rating) %><%= '☆'.repeat(5-r.rating) %></div><p>“<%= r.comment %>”</p><footer><span><%= r.customer_name||'Veloura Guest' %></span><small><%= r.service_name||'Salon experience' %><%= r.verified?' · Verified':'' %></small></footer></blockquote><% }) %></div>
      <% if(customer){ %><div class="review-form"><div><p class="eyebrow">SHARE YOUR EXPERIENCE</p><h2>Leave a review</h2></div><form action="/account/reviews" method="post"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><div class="form-row"><label>Service ID<input type="number" name="service_id" placeholder="e.g. 1"></label><label>Rating<select name="rating"><option value="5">5 — Excellent</option><option value="4">4 — Very good</option><option value="3">3 — Good</option></select></label></div><label>Your review<textarea name="comment" required rows="4"></textarea></label><button class="btn btn-primary">Publish review</button></form></div><% } %>
    </div>
  </section>
</main>
<%- include('../partials/footer') %>
