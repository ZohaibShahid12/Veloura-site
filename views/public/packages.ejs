<%- include('../partials/head') %><%- include('../partials/header') %><%- include('../partials/flash') %><main id="main-content"><section class="page-hero"><div class="container"><p class="eyebrow">CURATED BEAUTY JOURNEYS</p><h1>More care. Better value. One seamless plan.</h1><p>Choose a ready-made ritual or ask our team to create a custom package around your schedule.</p></div></section><section class="section"><div class="container"><div class="package-directory"><% packages.forEach((p,i)=>{ %><article class="package-feature reveal"><img src="<%= p.image %>" alt="<%= p.name %>"><div><p class="eyebrow"><%= p.category %> · <%= p.duration_days %> days</p><h2><%= p.name %></h2><p><%= p.description %></p><ul><li>Coordinated appointment planning</li><li>Preferred package pricing</li><li>Digital progress and service balance</li><li>Gift-ready purchase option</li></ul><div class="price-line"><b><%= money(p.price) %></b><del><%= money(p.original_price) %></del><span>Save <%= money(p.original_price-p.price) %></span></div><a class="btn btn-primary" href="/book">Build your schedule</a></div></article><% }) %></div><div class="custom-builder"><div><p class="eyebrow light">BESPOKE PACKAGE</p><h2>Create your own beauty edit.</h2><p>Combine hair, skin, makeup and nail services and our team will coordinate the right experts, branch and timings.</p></div><a href="/book" class="btn btn-gold">Start a custom package</a></div></div></section></main><%- include('../partials/footer') %>
