<%- include('../partials/head') %><%- include('../partials/header') %><%- include('../partials/flash') %><main id="main-content"><section class="page-hero compact"><div class="container"><p class="eyebrow">YOUR BEAUTY BAG</p><h1>Review your selection.</h1></div></section><section class="section top-tight"><div class="container cart-layout"><div class="cart-items"><% items.forEach(item=>{ %><article class="cart-item"><img src="<%= item.image %>" alt="<%= item.name %>"><div><h3><a href="/product/<%= item.slug %>"><%= item.name %></a></h3><p><%= money(item.price) %> each · <%= item.stock %> in stock</p><form action="/cart/update" method="post"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><input type="hidden" name="item_id" value="<%= item.id %>"><label>Qty<input type="number" name="qty" value="<%= item.qty %>" min="0" max="<%= item.stock %>"></label><button class="text-button">Update</button></form></div><b><%= money(item.subtotal) %></b></article><% }) %><% if(!items.length){ %><div class="empty-state"><span>◇</span><h3>Your beauty bag is empty</h3><p>Explore expert-selected aftercare and beauty essentials.</p><a class="btn btn-primary" href="/shop">Browse the shop</a></div><% } %></div><% if(items.length){ %><aside class="checkout-card"><p class="eyebrow">ORDER SUMMARY</p><div class="summary-line"><span>Subtotal</span><b><%= money(total) %></b></div><div class="summary-line"><span>Delivery</span><b>Complimentary</b></div><div class="summary-total"><span>Total</span><b><%= money(total) %></b></div><form action="/checkout" method="post" class="premium-form"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><label>Name<input required name="name" value="<%= customer?.name||'' %>"></label><div class="form-row"><label>Email<input required type="email" name="email" value="<%= customer?.email||'' %>"></label><label>Phone<input required name="phone" value="<%= customer?.phone||'' %>"></label></div><label>Fulfilment<select name="fulfillment"><option value="delivery">Home delivery</option><option value="pickup">Salon pickup</option></select></label><label>Address<textarea name="address" rows="2" placeholder="Delivery address"></textarea></label><label>Payment<select name="payment_method"><option>Card</option><option>Easypaisa</option><option>JazzCash</option><option>Bank Transfer</option><option>Cash on Pickup</option></select></label><button class="btn btn-primary btn-lg btn-block">Complete secure checkout</button><small class="form-note">This demo uses a safe sandbox payment flow and never stores card numbers.</small></form></aside><% } %></div></section></main><%- include('../partials/footer') %>
