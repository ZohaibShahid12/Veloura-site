<%- include('../partials/head') %><%- include('../partials/header') %><%- include('../partials/flash') %><main id="main-content"><section class="bridal-hero"><div class="bridal-visual"><img src="https://images.unsplash.com/photo-1519741497674-611481863552?auto=format&fit=crop&w=1600&q=88" alt="Luxury bridal beauty"></div><div class="bridal-copy"><p class="eyebrow light">VELOURA BRIDAL ATELIER</p><h1>Timeless beauty for your most photographed chapter.</h1><p>From skin preparation and trials to the final drape, one coordinated team manages every considered detail.</p><a href="#bridal-consultation" class="btn btn-gold">Request a bridal consultation</a></div></section><section class="section"><div class="container"><div class="section-heading centered"><p class="eyebrow">THE BRIDAL JOURNEY</p><h2>One plan. Every celebration.</h2></div><div class="journey-grid"><div><span>01</span><h3>Private consultation</h3><p>Discuss events, wardrobe, jewellery, venue, preferences and skin history.</p></div><div><span>02</span><h3>Trials & preparation</h3><p>Coordinate makeup trials, hair trials, skin rituals and colour services.</p></div><div><span>03</span><h3>Event timeline</h3><p>Receive a structured beauty schedule with deposits and balances clearly tracked.</p></div><div><span>04</span><h3>Wedding-day care</h3><p>Your dedicated team arrives prepared with notes, references and final details.</p></div></div></div></section><section class="section blush-section"><div class="container bridal-packages"><div><p class="eyebrow">CELEBRATION EDITS</p><h2>Packages for every event</h2><p>Engagement, Mehndi, Nikkah, Baraat, Walima and complete multi-event journeys are available.</p></div><div class="bridal-package-list"><div><span>ENGAGEMENT</span><b>From PKR 28,000</b></div><div><span>MEHNDI</span><b>From PKR 32,000</b></div><div><span>NIKKAH</span><b>From PKR 38,000</b></div><div><span>BARAAT SIGNATURE</span><b>From PKR 45,000</b></div><div><span>WALIMA</span><b>From PKR 42,000</b></div></div></div></section><section class="section" id="bridal-consultation"><div class="container form-feature"><div><p class="eyebrow">PRIVATE CONSULTATION</p><h2>Tell us about your celebration.</h2><p>Your request enters the bridal dashboard, where a coordinator can assign artists, update your quotation, record payments and track the full journey.</p><div class="mini-team"><% experts.forEach(e=>{ %><img src="<%= e.image %>" alt="<%= e.name %>" title="<%= e.name %>"><% }) %><span>Dedicated bridal experts</span></div></div><form method="post" action="/bridal" class="premium-form"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><div class="form-row"><label>Full name<input required name="name" value="<%= customer?.name||'' %>"></label><label>Phone<input required name="phone" value="<%= customer?.phone||'' %>"></label></div><div class="form-row"><label>Email<input type="email" name="email" value="<%= customer?.email||'' %>"></label><label>Event type<select name="event_type"><option>Baraat</option><option>Walima</option><option>Nikkah</option><option>Mehndi</option><option>Engagement</option><option>Multiple events</option></select></label></div><div class="form-row"><label>Event date<input required type="date" name="event_date"></label><label>Package<select name="package_name"><option>Bridal Signature</option><option>Multi-Event Journey</option><option>Custom Consultation</option></select></label></div><label>Venue<input name="venue" placeholder="City or venue"></label><label>Your vision<textarea name="notes" rows="4" placeholder="Tell us about your outfit, jewellery, preferred look, family bookings or travel needs."></textarea></label><input type="hidden" name="total" value="45000"><button class="btn btn-primary btn-lg">Submit consultation request</button></form></div></section></main><%- include('../partials/footer') %>
