<%- include('../partials/head') %><%- include('../partials/header') %><%- include('../partials/flash') %><main id="main-content"><section class="page-hero membership-hero"><div class="container"><p class="eyebrow">VELOURA CIRCLE</p><h1>Your beauty routine, rewarded.</h1><p>Unlock preferred pricing, priority access, loyalty multipliers and thoughtful member privileges.</p></div></section><section class="section top-tight"><div class="container"><div class="membership-grid"><% memberships.forEach((m,i)=>{ %><article class="membership-card <%= m.name==='Platinum'?'featured':'' %>"><% if(m.name==='Platinum'){ %><span class="recommended">MOST LOVED</span><% } %><p class="eyebrow"><%= m.name.toUpperCase() %></p><h2><%= money(m.price_monthly) %><small>/month</small></h2><p>or <%= money(m.price_yearly) %> annually</p><div class="membership-value"><b><%= m.discount_percent %>%</b><span>service savings</span><b><%= m.points_multiplier %>×</b><span>points multiplier</span></div><ul><% String(m.benefits).split('|').forEach(b=>{ %><li>✓ <%= b %></li><% }) %></ul><% if(user && customer){ %><form method="post" action="/memberships/<%= m.id %>/join"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><button class="btn <%= m.name==='Platinum'?'btn-gold':'btn-primary' %> btn-block">Choose <%= m.name %></button></form><% } else { %><a class="btn <%= m.name==='Platinum'?'btn-gold':'btn-primary' %> btn-block" href="/login?next=/memberships">Sign in to join</a><% } %></article><% }) %></div><div class="benefit-strip"><div><b>Birthday ritual</b><span>Member-only celebration benefits</span></div><div><b>Priority access</b><span>Earlier booking opportunities</span></div><div><b>Beauty wallet</b><span>Points and rewards in one place</span></div><div><b>VIP preferences</b><span>Your details remembered securely</span></div></div></div></section></main><%- include('../partials/footer') %>
