<%- include('../partials/head') %><%- include('../partials/header') %><%- include('../partials/flash') %><main id="main-content"><section class="product-detail"><div class="product-detail-image"><img src="<%= product.image %>" alt="<%= product.name %>"></div><div class="product-detail-copy"><p class="eyebrow"><%= product.brand %> · <%= product.category %></p><h1><%= product.name %></h1><div class="rating-line"><span>★★★★★</span><b><%= product.rating %></b></div><p class="lead"><%= product.description %></p><h2><%= money(product.price) %></h2><p class="stock-line <%= product.stock<=product.min_stock?'warning':'' %>"><%= product.stock>0?`${product.stock} available`:'Out of stock' %></p><form action="/cart/add" method="post" class="buy-form"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><input type="hidden" name="product_id" value="<%= product.id %>"><label>Quantity<input type="number" name="qty" min="1" max="<%= product.stock %>" value="1"></label><button class="btn btn-primary btn-lg" <%= product.stock<1?'disabled':'' %>>Add to beauty bag</button></form><% if(customer){ %><form action="/wishlist/<%= product.id %>" method="post"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><button class="text-button">♡ Save to wishlist</button></form><% } %><div class="product-promises"><div><b>Expert selected</b><span>Chosen for salon-quality aftercare</span></div><div><b>Flexible fulfilment</b><span>Delivery or salon pickup</span></div><div><b>Secure checkout</b><span>Sandbox payment included</span></div></div></div></section><section class="section blush-section"><div class="container detail-columns"><div><p class="eyebrow">HOW TO USE</p><h2>A simple addition to your ritual.</h2><div class="prose"><p>Use according to your expert’s recommendation and the product directions. Stop use if irritation occurs.</p><h3>Why it was selected</h3><ul><li>Professional-quality formulation or tool</li><li>Suitable for a considered home-care routine</li><li>Pairs naturally with selected Veloura services</li></ul></div></div><aside class="sticky-card"><p class="eyebrow">NEED GUIDANCE?</p><h3>Book a consultation</h3><p>Our experts can recommend the right service and product routine for your goals.</p><a href="/book" class="btn btn-primary btn-block">Book consultation</a></aside></div></section><section class="section"><div class="container"><div class="section-heading"><p class="eyebrow">COMPLETE THE SHELF</p><h2>Related products</h2></div><div class="product-grid"><% related.forEach(p=>{ %><article class="product-card"><a href="/product/<%= p.slug %>"><img src="<%= p.image %>" alt="<%= p.name %>"></a><div><small><%= p.brand %></small><h3><a href="/product/<%= p.slug %>"><%= p.name %></a></h3><div class="product-meta"><b><%= money(p.price) %></b><span>★ <%= p.rating %></span></div></div></article><% }) %></div></div></section></main><%- include('../partials/footer') %>
