<%- include('../partials/head') %><%- include('../partials/header') %><%- include('../partials/flash') %><main id="main-content"><section class="page-hero"><div class="container"><p class="eyebrow">THE VELOURA COLLECTIVE</p><h1>Artists with an eye for you.</h1><p>Browse specialists by branch and expertise, then reserve your preferred professional.</p></div></section><section class="section top-tight"><div class="container"><form class="inline-filters" method="get"><label>Branch<select name="branch"><option value="">All branches</option><% branches.forEach(b=>{ %><option value="<%= b.id %>" <%= Number(filters.branch)===b.id?'selected':'' %>><%= b.name %></option><% }) %></select></label><label>Speciality<input name="speciality" value="<%= filters.speciality %>" placeholder="e.g. Bridal or Balayage"></label><button class="btn btn-primary">Filter experts</button><a class="btn btn-soft" href="/experts">Reset</a></form><div class="expert-directory"><% experts.forEach((e,i)=>{ %><article class="expert-profile-card reveal"><div class="expert-photo"><img src="<%= e.image %>" alt="<%= e.name %>"><span>★ <%= e.rating %></span></div><div><p class="eyebrow"><%= e.branch_name %></p><h2><%= e.name %></h2><h4><%= e.title %></h4><p><%= e.bio %></p><div class="tag-row"><% String(e.speciality||'').split(',').forEach(tag=>{ %><span><%= tag.trim() %></span><% }) %></div><div class="expert-stats"><div><b><%= e.rating %></b><small>rating</small></div><div><b><%= e.start_time %></b><small>starts</small></div><div><b><%= e.end_time %></b><small>finishes</small></div></div><a class="btn btn-primary" href="/book?staff=<%= e.id %>">Book with <%= e.name.split(' ')[0] %></a></div></article><% }) %></div></div></section></main><%- include('../partials/footer') %>
